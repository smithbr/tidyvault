```

## Projects with no next action

```dataview
TABLE WITHOUT ID file.link AS "Project", phase AS "Phase", priority AS "Priority"
FROM "Projects"
WHERE (phase = "in-progress" OR phase = "not-started")
  AND length(filter(file.inlinks, (t) => startswith(meta(t).path, "Tasks/") AND t.status = "next-action" AND t.project = file.link)) = 0
SORT phase ASC
```

## Project review

Each project's status sheet is its `## Status` section, rewritten on every sweep.

```dataview
TABLE WITHOUT ID file.link AS "Project", phase AS "Phase", health AS "Health", last_sweep AS "Last sweep", priority AS "Priority"
FROM "Projects"
WHERE phase != "done" AND phase != "cancelled"
SORT choice(health = "blocked", 0, choice(health = "at-risk", 1, choice(health = "on-track", 2, 3))) ASC, last_sweep ASC
```

## Agent activity

```dataview
TABLE WITHOUT ID file.link AS "Log", date AS "Date"
FROM "Agents/logs"
WHERE date >= date(today) - dur(7 days)
SORT date DESC, file.name ASC
```

## Recently completed

```dataview
TABLE WITHOUT ID file.link AS "Task", completed AS "Completed", project AS "Project"
FROM "Archive" OR "Tasks"
WHERE (status = "done" OR status = "cancelled") AND completed AND completed >= date(today) - dur(7 days)
SORT completed DESC
```
