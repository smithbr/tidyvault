{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git commit --amend*)"
    ],
    "ask": [
[[% if store %]]
      "Read(/_files/**)",
      "Edit(/_files/**)",
      "Write(/_files/**)",
[[% endif %]]
[[% if obsidian %]]
      "Edit(/.obsidian/**)",
      "Write(/.obsidian/**)"
[[% endif %]]
    ],
    "allow": [
      "Bash(python3 .scripts/vault-lint*)"
    ]
  }
}
