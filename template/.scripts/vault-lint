def _merge_archive_fields() -> list:
    """Union of all folder schemas in a stable order (Tasks first)."""
    seen, out = set(), []
    for folder in ["Tasks", "Projects", "Areas", "Resources", "People"]:
        for name, spec in FOLDER_FIELDS[folder]:
            if name not in seen:
                seen.add(name)
                out.append((name, spec))
    return out


def schema_for(note: "Note") -> list:
    """Ordered [(field, spec)] allowed for `note`."""
    folder, fm = note.folder, note.fm
    if folder == "Agents":
        return AGENT_LOG_FIELDS if fm is not None and fm.scalar("type") == "log" else MANUAL_FIELDS
    if folder == "Home":
        return HOME_FIELDS
    if folder == "Archive":
        origin = fm.scalar("archived_from") if fm else None
        if origin in FOLDER_FIELDS:
            # Agents/schema.md: the note keeps its original folder's fields only.
            body = FOLDER_FIELDS[origin]
        else:  # archived_from missing or wrong (reported): accept any folder's fields
            body = _merge_archive_fields()
        return COMMON_HEAD + body + ARCHIVE_EXTRA + COMMON_TAIL
    return COMMON_HEAD + FOLDER_FIELDS[folder] + COMMON_TAIL


