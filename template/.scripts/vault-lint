def _references(v: Vault) -> dict:
    """rel -> {source rel: embedded?} for every resolvable link in the vault."""
    refs: dict = {}
    for n in v.notes.values():
        pairs = []
        if not n.is_template:
            pairs += [(m.group(1), m.group(2)) for _, line in body_lines_outside_code(n)
                      for m in WIKILINK_ANY.finditer(line)]
        if n.fm:
            pairs += [(m.group(1), m.group(2)) for e in n.fm.entries for val in n.fm.values(e.key)
                      for m in WIKILINK_ANY.finditer(val.text)]
        for bang, inner in pairs:
            rel = v.resolve(parse_link(inner), n.rel)
            if rel and rel != n.rel:
                d = refs.setdefault(rel, {})
                d[n.rel] = d.get(n.rel, False) or bool(bang)
    return refs


@check("attachments", "attachments in _attachments/<note-slug>/, embedded by their note; orphans")
def check_attachments(v: Vault) -> Iterator[Finding]:
    refs = v.refs
    to_move: dict = {}  # note-slug folder -> files that belong in the file store
    for rel in v.files + v.store_files:
        parts = rel.split("/")
        if parts[0] not in (ATTACH_DIR, STORE_DIR):
            continue
        top = parts[0]
        if rel.endswith(".md"):
            yield Finding("attachments", WARNING, rel, 0, f"a note inside {top}/; notes belong in a content folder")
            continue
        if rel.startswith(RAW_DIR + "/"):
            continue  # raw originals: any depth, never embedded; notes embed the renamed copy
        if len(parts) == 2:
            yield Finding("attachments", WARNING, rel, 0,
                          f"attachment at the top of {top}/; move it to {top}/<note-slug>/")
        elif len(parts) > 3:
            yield Finding("attachments", WARNING, rel, 0,
                          f"nested too deep; attachments sit directly in {top}/<note-slug>/")
        if top == ATTACH_DIR and v.store_attached and len(parts) == 3:
            try:
                if belongs_in_store(rel, (v.root / rel).stat().st_size):
                    to_move.setdefault(parts[1], []).append(rel)
            except OSError:
                pass
        sources = refs.get(rel, {})
        if not sources:
            yield Finding("attachments", INFO, rel, 0, "orphan: no note embeds or links this attachment")
        if len(parts) != 3:
            continue
        folder, name = parts[1], parts[2]
        stem, _, ext = name.rpartition(".")
        if not KEBAB.match(stem or ext) or ext != ext.lower():
            yield Finding("attachments", WARNING, rel, 0, "attachment filename is not kebab-case")
        owners = [r for r in v.by_stem.get(folder, []) if r in v.notes and v.notes[r].is_note]
        if not owners:
            yield Finding("attachments", WARNING, rel, 0,
                          f"folder '{folder}/' matches no note; name it after the note that embeds the file")
        elif not any(sources.get(o) for o in owners):
            yield Finding("attachments", WARNING, rel, 0,
                          f"not embedded by its note [[{folder}]]; add ![[{name}]] there")
    for folder, rels in sorted(to_move.items()):
        yield Finding("attachments", INFO, f"{ATTACH_DIR}/{folder}/", 0,
                      f"{len(rels)} file(s) belong in the file store; run .scripts/store-move")


