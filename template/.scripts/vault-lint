def _status_to_phase(n: Note) -> bool:
    """A project (or one archived from Projects/) still on the old `status` key:
    --fix renames it to `phase` (Agents/schema.md, 2026-10-11)."""
    return n.is_project and n.fm is not None and n.fm.get("status") is not None and n.fm.get("phase") is None


def _fixed_raw(v: Value, key: str) -> str:
    if v.style == "plain" and WIKILINK_FULL.match(v.raw):
        return f'"{v.raw}"'
    if v.style == "double" and key in DATE_FIELDS and ISO_DATE.match(v.text):
        return v.text
    return v.raw


def render_frontmatter(note: Note) -> tuple:
    """Return (new_frontmatter_text, [change descriptions])."""
    fm = note.fm
    changes = []
    order = [n for n, _ in schema_for(note)] if note.is_note else []
    kept = []
    for e in fm.entries:
        if e.kind == "empty":
            changes.append(f"deleted empty key '{e.key}'")
            continue
        if e.key in RETIRED_REDUNDANT or (e.key == "archive" and e.kind == "scalar" and e.value.text == "false"):
            changes.append(f"deleted retired field '{e.key}'")
            continue
        if e.key == "status" and _status_to_phase(note):
            e = Entry("phase", e.line, e.kind, e.value, e.items)
            changes.append("renamed project 'status' to 'phase'")
        kept.append(e)
    known = [e for e in kept if e.key in order]
    unknown = [e for e in kept if e.key not in order]
    ordered = sorted(known, key=lambda e: order.index(e.key)) + unknown
    if [e.key for e in ordered] != [e.key for e in kept]:
        changes.append("reordered keys to schema order")
    out = ["---"]
    for e in ordered:
        if e.kind == "scalar":
            raw = _fixed_raw(e.value, e.key)
            if raw != e.value.raw:
                what = "quoted wikilink" if raw.startswith('"[[') else "unquoted date"
                changes.append(f"{what} in '{e.key}'")
            out.append(f"{e.key}: {raw}")
        else:
            if e.kind == "inline":
                changes.append(f"converted inline list '{e.key}' to block list")
            out.append(f"{e.key}:")
            for it in e.items:
                raw = _fixed_raw(it, e.key)
                if raw != it.raw and e.kind != "inline":
                    changes.append(f"quoted wikilink in '{e.key}'")
                out.append(f"  - {raw}")
    out.append("---")
    return "\n".join(out) + "\n", changes


def atomic_write(path: Path, data: str, expect: Optional[bytes] = None) -> bool:
    """Write via a temp file + fsync + rename in the same folder, keeping the
    mode. With `expect`, give up (return False) if the file no longer holds
    those bytes, so a concurrent edit is never clobbered."""
    if path.is_symlink():
        return False
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".vault-lint-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        if expect is not None and path.read_bytes() != expect:
            os.unlink(tmp)
            return False
        os.replace(tmp, path)
        return True
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def fixed_text(n: Note) -> tuple:
    """(new file text | None, [changes]) for one note; None when nothing to do."""
    head = n.text[: n.fm.body_offset]
    new_head, changes = render_frontmatter(n)
    if not head.endswith("\n"):          # file ends right after the closing ---
        new_head = new_head[:-1]
    if n.crlf:
        raw_lines = n.raw.split("\n")
        head_lines = raw_lines[: n.fm.end_line]
        if not all(l.endswith("\r") for l in head_lines[: len(head_lines) - (0 if head.endswith("\n") else 1)]):
            return None, []                 # mixed line endings in the frontmatter: hands off
        raw_head_len = sum(len(l) + 1 for l in head_lines) - (0 if head.endswith("\n") else 1)
        body = n.raw[raw_head_len:]
        new_head = new_head.replace("\n", "\r\n")
        head = n.raw[:raw_head_len]
    else:
        body = n.text[n.fm.body_offset:]
        if _formattable(n):
            new_body, fchanges = format_body(body)
            if new_body != body:
                body = new_body
                changes = changes + ["body: " + c for c in fchanges]
    if n.bom:
        changes.append("removed UTF-8 byte-order mark")
    if new_head == head and not n.bom and not any(c.startswith("body: ") for c in changes):
        return None, []
    if not changes:
        changes = ["normalised frontmatter layout (blank lines / list indent)"]
    return new_head + body, list(dict.fromkeys(changes))


def apply_fixes(v: Vault, selected: Optional[set]) -> list:
    """Rewrite frontmatter of fixable notes. Returns [(rel, [changes])].
    Body bytes (including their line endings) are never changed."""
    report = []
    for n in sorted(v.notes.values(), key=lambda n: n.rel):
        if not n.fm or not n.is_note or (selected is not None and not _selected(n.rel, selected)):
            continue
        if n.fm.unsafe or not n.fixable_file:
            continue
        data, changes = fixed_text(n)
        if data is None:
            continue
        original = (("\ufeff" if n.bom else "") + n.raw).encode("utf-8")
        if atomic_write(v.root / n.rel, data, expect=original):
            report.append((n.rel, changes))
        else:
            report.append((n.rel, ["skipped: file changed on disk while fixing; run --fix again"]))
    return report


# --------------------------------------------------------------------------
# --archive-closed and --promote: the mechanical GTD steps
# --------------------------------------------------------------------------

def _write_new(path: Path, data: str, mode: int) -> bool:
    """Create `path` with `data` atomically; False (nothing written) if it exists."""
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".vault-lint-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        try:
            os.link(tmp, path)             # fails if the name is taken: never clobbers
        except FileExistsError:
            return False
        return True
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def _on_disk(n: Note) -> bytes:
    return (("﻿" if n.bom else "") + n.raw).encode("utf-8")


def _skip_reason(v: Vault, n: Note) -> Optional[str]:
    if n.fm.unsafe or not n.fixable_file:
        return "frontmatter outside the subset, or unreadable; fix by hand"
    if (v.root / n.rel).is_symlink():
        return "symlink"
    return None


def archive_closed(v: Vault, selected: Optional[set], dry: bool) -> dict:
    """Agents/procedures.md, "Archive a file", for every closed task still in
    Tasks/: set `completed` (today, when missing), add `archived: true` and
    `archived_from: Tasks`, move to Archive/ under the same filename. Closed
    projects are left alone: archiving one means sorting its Resources."""
    moved, skipped, left = [], [], []
    for p in sorted(v.content_notes("Projects"), key=lambda n: n.rel):
        if p.fm and p.state in CLOSED and (selected is None or _selected(p.rel, selected)):
            left.append(p.rel)
    tail = {k for k, _ in COMMON_TAIL}
    for n in sorted(v.content_notes("Tasks"), key=lambda n: n.rel):
        if not n.fm or n.fm.scalar("status") not in CLOSED:
            continue
        if selected is not None and not _selected(n.rel, selected):
            continue
        dest = v.root / "Archive" / f"{n.stem}.md"
        why = _skip_reason(v, n)
        if not why and (n.fm.get("archived") or n.fm.get("archived_from")):
            why = "already has archived fields"
        if not why and (dest.exists() or len(v.by_stem.get(n.stem.lower(), [])) > 1):
            why = "Archive/ or another folder already holds that filename"
        if why:
            skipped.append((n.rel, why))
            continue
        eol = "\r" if n.crlf else ""
        lines = n.raw.split("\n")
        at = next((e.line - 1 for e in n.fm.entries if e.key in tail), n.fm.end_line - 1)
        add = []
        set_completed = n.fm.get("completed") is None
        if set_completed:
            add.append(f"completed: {v.today.isoformat()}")
        add += ["archived: true", "archived_from: Tasks"]
        lines[at:at] = [a + eol for a in add]
        item = {"from": n.rel, "to": f"Archive/{n.stem}.md", "completed_set": set_completed,
                "project": next((link_target(x) for x in n.fm.values("project") if link_target(x)), None)}
        if dry:
            moved.append(item)
            continue
        data = ("﻿" if n.bom else "") + "\n".join(lines)
        src = v.root / n.rel
        mode = os.stat(src).st_mode & 0o7777
        if not _write_new(dest, data, mode):
            skipped.append((n.rel, "Archive/ already holds that filename"))
            continue
        if src.read_bytes() != _on_disk(n):         # edited while we worked: undo, touch nothing
            dest.unlink()
            skipped.append((n.rel, "file changed on disk while archiving; run again"))
            continue
        src.unlink()
        moved.append(item)
    return {"moved": moved, "skipped": skipped, "projects_left": left}


def _promotion_key(t: Note) -> tuple:
    """Agents/gtd.md, Promote on close: highest priority, then earliest due,
    then oldest created."""
    fm = t.fm
    return (PRIORITY_RANK.get(fm.scalar("priority"), 2), fm.scalar("due") or "9999",
            fm.scalar("created") or "9999", t.stem)


def promotion_plan(v: Vault) -> list:
    """One entry per active project that has no next action (`not-started`,
    `in-progress`): the queued task to promote (all blockers closed, best by
    _promotion_key), or None when the project has none."""
    by_proj = _tasks_for_projects(v)
    plan = []
    for p in sorted(v.content_notes("Projects"), key=lambda n: n.rel):
        status = p.state
        if status not in PROJECT_NEXT_ACTIONS or PROJECT_NEXT_ACTIONS[status][0] < 1:
            continue
        ts = [t for t in by_proj.get(p.rel, []) if t.fm]
        if any(t.fm.scalar("status") == "next-action" for t in ts):
            continue
        ready = []
        for t in ts:
            if t.fm.scalar("status") != "queued":
                continue
            blockers = [link_target(x) for x in t.fm.values("blocked_by") if link_target(x)]
            if all(_is_closed(v, b, t.rel) for b in blockers):
                ready.append(t)
        plan.append({"project": p, "task": min(ready, key=_promotion_key) if ready else None})
    return plan


def promote(v: Vault, selected: Optional[set], dry: bool) -> dict:
    """Agents/gtd.md, Promote on close: each active project with no next
    action gets its best queued, unblocked task set to `next-action`. Existing
    `contexts` stay; none are guessed, so a task without them is reported."""
    promoted, skipped, stuck = [], [], []
    for item in promotion_plan(v):
        p, t = item["project"], item["task"]
        if selected is not None and not (_selected(p.rel, selected) or (t and _selected(t.rel, selected))):
            continue
        if t is None:
            stuck.append(p.stem)
            continue
        why = _skip_reason(v, t)
        status = t.fm.get("status")
        eol = "\r" if t.crlf else ""
        lines = t.raw.split("\n")
        if not why and (not status or lines[status.line - 1].rstrip("\r").strip() != "status: queued"):
            why = "status line isn't plain `status: queued`"
        if why:
            skipped.append((t.rel, why))
            continue
        rec = {"task": t.stem, "path": t.rel, "project": p.stem, "needs_contexts": not t.fm.values("contexts")}
        if dry:
            promoted.append(rec)
            continue
        lines[status.line - 1] = "status: next-action" + eol
        src = v.root / t.rel
        if not atomic_write(src, ("﻿" if t.bom else "") + "\n".join(lines), expect=_on_disk(t)):
            skipped.append((t.rel, "file changed on disk while promoting; run again"))
            continue
        promoted.append(rec)
    return {"promoted": promoted, "skipped": skipped, "no_candidate": stuck}


def print_archive_report(r: dict, dry: bool, out) -> None:
    w = "would archive" if dry else "archived"
    for m in r["moved"]:
        extra = f" (completed set to today)" if m["completed_set"] else ""
        out.write(f"{w} {m['from']} -> {m['to']}{extra}\n")
    for rel, why in r["skipped"]:
        out.write(f"skipped {rel}: {why}\n")
    for rel in r["projects_left"]:
        out.write(f"left for an agent: {rel} (closed project; archiving sorts its tasks and Resources)\n")
    out.write(f"--archive-closed: {len(r['moved'])} task(s) {'would be ' if dry else ''}archived\n")


def print_promote_report(r: dict, dry: bool, out) -> None:
    w = "would promote" if dry else "promoted"
    for m in r["promoted"]:
        out.write(f"{w} {m['path']} to next-action, project {m['project']}"
                  + ("; needs contexts (agent)" if m["needs_contexts"] else "") + "\n")
    for rel, why in r["skipped"]:
        out.write(f"skipped {rel}: {why}\n")
    for slug in r["no_candidate"]:
        out.write(f"left for an agent: {slug} has no next action and no queued task ready "
                  "(write one from the project body, or change its phase)\n")
    out.write(f"--promote: {len(r['promoted'])} task(s) {'would be ' if dry else ''}promoted\n")


# --------------------------------------------------------------------------
# --review: the GTD daily/weekly review as text, for agents without Dataview
# --------------------------------------------------------------------------

PRIORITY_RANK = {"urgent": 0, "high": 1, "med": 2, "low": 3}
STALE_DAYS = 14
WAITING_STALE_DAYS = 7


def _git_last_changes(root: Path) -> Optional[dict]:
    """rel -> last commit date (uncommitted changes count as today's date
    marker None). Returns None when root isn't the top of a git work tree."""
    import subprocess
    try:
        top = subprocess.run(["git", "-C", str(root), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10)
        if top.returncode != 0 or Path(top.stdout.strip()).resolve() != root:
            return None
        log = subprocess.run(["git", "-C", str(root), "-c", "core.quotepath=off", "log",
                              "--format=%x00%cs", "--name-only", "--", "Tasks", "Projects", "Archive"],
                             capture_output=True, text=True, timeout=30)
        dirty = subprocess.run(["git", "-C", str(root), "-c", "core.quotepath=off", "status",
                                "--porcelain", "--", "Tasks", "Projects", "Archive"],
                               capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if log.returncode != 0:
        return None
    out: dict = {}
    date = None
    for line in log.stdout.split("\n"):
        if line.startswith("\x00"):
            date = parse_date(line[1:].strip())
        elif line.strip() and date:
            out.setdefault(line.strip(), date)
    for line in dirty.stdout.split("\n"):
        if len(line) > 3:
            out[line[3:].split(" -> ")[-1].strip('"')] = "dirty"
    return out


def _brief(n: Note) -> dict:
    fm = n.fm
    d = {"path": n.rel, "slug": n.stem, "title": n.title or n.stem, "status": n.state}
    for k in ("due", "priority", "waiting_since", "created"):
        if fm.scalar(k):
            d[k] = fm.scalar(k)
    for k in ("project", "waiting_on"):
        t = next((link_target(x) for x in fm.values(k) if link_target(x)), None)
        if t:
            d[k] = t
    for k in ("area", "contexts", "blocked_by"):
        vals = [link_target(x) or x.text for x in fm.values(k)]
        if vals:
            d[k] = vals
    return d


def _is_closed(v: Vault, target: str, source: str) -> bool:
    rel = v.resolve(target, source)
    n = v.notes.get(rel) if rel else None
    if not n or not n.fm:
        return False
    return n.folder == "Archive" or n.state in CLOSED


def _task_sort_key(d: dict):
    return (d.get("due") or "9999", PRIORITY_RANK.get(d.get("priority"), 2), d.get("created") or "", d["slug"])


def build_review(v: Vault, days: int = 7, use_git: bool = True) -> dict:
    today = v.today
    tasks = [t for t in v.content_notes("Tasks") if t.fm]
    projects = [p for p in v.content_notes("Projects") if p.fm]
    open_tasks = [t for t in tasks if t.fm.scalar("status") in OPEN_TASK]
    findings = run_checks(v, None)
    r: dict = {"today": today.isoformat(), "days": days,
               "lint": {"errors": sum(f.severity == ERROR for f in findings),
                        "warnings": sum(f.severity == WARNING for f in findings)}}

    # Overdue and due soon (open tasks and active projects)
    due = []
    for n in open_tasks + [p for p in projects if p.state in ACTIVE_PROJECT]:
        d = parse_date(n.fm.scalar("due") or "")
        if d and d <= today + dt.timedelta(days=days):
            b = _brief(n)
            b["kind"] = "project" if n.folder == "Projects" else "task"
            b["days_left"] = (d - today).days
            b["overdue"] = d < today
            due.append(b)
    r["due"] = sorted(due, key=_task_sort_key)

    # Next actions by project and by context
    nexts = sorted((_brief(t) for t in open_tasks if t.fm.scalar("status") == "next-action"), key=_task_sort_key)
    by_project: dict = {}
    by_context: dict = {}
    for b in nexts:
        by_project.setdefault(b.get("project") or "", []).append(b)
        for c in b.get("contexts") or [""]:
            by_context.setdefault(c, []).append(b)
    r["next_actions_by_project"] = {k: by_project[k] for k in sorted(by_project, key=lambda k: (k == "", k))}
    r["next_actions_by_context"] = {k: by_context[k] for k in sorted(by_context, key=lambda k: (k == "", k))}

    # Inbox
    inbox = [t for t in open_tasks if t.fm.scalar("status") == "inbox"]
    r["inbox"] = sorted((_brief(t) for t in inbox), key=lambda b: (b.get("created") or "", b["slug"]))
    r["queued_steps"] = sum(1 for t in open_tasks if t.fm.scalar("status") == "queued")

    # Waiting for
    waiting = []
    for t in open_tasks:
        if t.fm.scalar("status") != "waiting-for":
            continue
        b = _brief(t)
        since = parse_date(t.fm.scalar("waiting_since") or "")
        b["age_days"] = (today - since).days if since else None
        b["stale"] = b["age_days"] is None or b["age_days"] >= WAITING_STALE_DAYS
        waiting.append(b)
    r["waiting"] = sorted(waiting, key=lambda b: (-(b["age_days"] if b["age_days"] is not None else 10**6), b["slug"]))

    # Blocked tasks whose blockers are all closed
    promote = []
    for t in open_tasks:
        if t.fm.scalar("status") not in ("inbox", "queued"):
            continue
        blockers = [link_target(x) for x in t.fm.values("blocked_by") if link_target(x)]
        unblocked = all(_is_closed(v, b, t.rel) for b in blockers)
        if blockers and unblocked:
            promote.append(_brief(t))
    r["promote"] = sorted(promote, key=_task_sort_key)

    # Projects breaking the one-next-action rule
    by_proj = _tasks_for_projects(v)
    to_promote = {x["project"].rel: x["task"].stem for x in promotion_plan(v) if x["task"]}
    rule = []
    for p in sorted(projects, key=lambda p: p.stem):
        status = p.state
        if status not in PROJECT_NEXT_ACTIONS:
            continue
        ts = [t for t in by_proj.get(p.rel, []) if t.folder == "Tasks"]
        n_next = [t.stem for t in ts if t.fm.scalar("status") == "next-action"]
        n_wait = [t.stem for t in ts if t.fm.scalar("status") == "waiting-for"]
        lo, hi = PROJECT_NEXT_ACTIONS[status]
        problem = None
        if lo == 1 and not n_next:
            problem = "no next action"
        elif hi is not None and len(n_next) > hi:
            problem = f"{len(n_next)} next actions (allowed {hi})"
        elif status == "waiting" and not n_wait:
            problem = "waiting project with no waiting-for task"
        if problem:
            item = {"path": p.rel, "slug": p.stem, "title": p.title or p.stem, "phase": status,
                    "problem": problem, "next_actions": n_next}
            if lo == 1 and not n_next and p.rel in to_promote:
                item["promote"] = to_promote[p.rel]
            rule.append(item)
    r["project_rule"] = rule

    # Stale in-progress projects
    changes = _git_last_changes(v.root) if use_git else None
    source = "git" if changes is not None else "mtime"

    def last_change(rel: str) -> Optional[dt.date]:
        if changes is not None:
            d = changes.get(rel)
            return today if d == "dirty" else d
        try:
            return dt.date.fromtimestamp((v.root / rel).stat().st_mtime)
        except OSError:
            return None

    archived_by_proj: dict = {}
    for t in v.content_notes("Archive"):
        for val in (t.fm.values("project") if t.fm else []):
            rel = v.resolve(link_target(val) or "", t.rel)
            if rel:
                archived_by_proj.setdefault(rel, []).append(t)
    stale = []
    for p in projects:
        if p.state != "in-progress":
            continue
        members = by_proj.get(p.rel, []) + archived_by_proj.get(p.rel, [])
        rels = [t.rel for t in members] or [p.rel]
        dates = [d for d in (last_change(x) for x in rels) if d]
        last = max(dates) if dates else None
        age = (today - last).days if last else None
        if age is None or age >= STALE_DAYS:
            stale.append({"path": p.rel, "slug": p.stem, "title": p.title or p.stem,
                          "last_change": last.isoformat() if last else None, "age_days": age,
                          "tasks": len(members)})
    r["stale_projects"] = {"source": source, "items": sorted(stale, key=lambda x: x["slug"])}

    # Closed but not archived
    r["closed_not_archived"] = [
        {"path": n.rel, "slug": n.stem, "title": n.title or n.stem, "status": n.state,
         "completed": n.fm.scalar("completed")}
        for n in sorted(tasks + projects, key=lambda n: n.rel) if n.state in CLOSED]

    # Someday/maybe ticklers
    revisit = []
    for a in sorted(v.content_notes("Areas"), key=lambda n: n.rel):
        sec = sections(a).get("Someday/maybe")
        if not sec:
            continue
        for i, line in enumerate(sec[1]):
            for m in REVISIT.finditer(line):
                d = parse_date(m.group(1).strip())
                if d and d <= today:
                    text = re.sub(r"^\s*[-*]\s+", "", REVISIT.sub("", line)).strip()
                    revisit.append({"path": a.rel, "area": a.stem, "line": sec[0] + 1 + i,
                                    "revisit": d.isoformat(), "text": text})
    r["revisit"] = sorted(revisit, key=lambda x: (x["revisit"], x["area"]))
    return r


def _fmt_task(b: dict, show_project: bool = True) -> str:
    bits = []
    if b.get("contexts"):
        bits.append(", ".join(b["contexts"]))
    if b.get("due"):
        bits.append(f"due {b['due']}")
    if b.get("priority"):
        bits.append(b["priority"])
    if show_project and b.get("project"):
        bits.append(f"project [[{b['project']}]]")
    elif show_project and b.get("area"):
        bits.append("area " + ", ".join(f"[[{a}]]" for a in b["area"]))
    tail = f" ({'; '.join(bits)})" if bits else ""
    return f"[[{b['slug']}]] {b['title']}{tail}"


def render_review(r: dict) -> str:
    out = [f"# GTD review, {r['today']}", ""]
    lint = r["lint"]
    out += [f"Lint: {lint['errors']} error(s), {lint['warnings']} warning(s). "
            "Run `python3 .scripts/vault-lint` for details.", ""]

    def section(title, items, fmt, empty="None."):
        out.append(f"## {title}")
        out.append("")
        out.extend(fmt(x) for x in items) if items else out.append(empty)
        out.append("")

    def due_line(b):
        when = (f"OVERDUE {-b['days_left']}d" if b["overdue"]
                else "due today" if b["days_left"] == 0 else f"in {b['days_left']}d")
        kind = " [project]" if b["kind"] == "project" else ""
        return f"- **{when}**{kind} {_fmt_task(b)}, {b['status']}"
    section(f"Overdue and due within {r['days']} days", r["due"], due_line)

    out += ["## Next actions by project", ""]
    if not r["next_actions_by_project"]:
        out += ["None.", ""]
    for proj, items in r["next_actions_by_project"].items():
        out.append(f"### {'[[' + proj + ']]' if proj else 'No project (area only)'}")
        out.extend(f"- {_fmt_task(b, show_project=not proj)}" for b in items)
        out.append("")

    out += ["## Next actions by context", ""]
    if not r["next_actions_by_context"]:
        out += ["None.", ""]
    for ctx, items in r["next_actions_by_context"].items():
        out.append(f"### {ctx or 'No context set'}")
        out.extend(f"- {_fmt_task(b)}" for b in items)
        out.append("")

    section(f"Inbox captures to clarify ({len(r['inbox'])})", r["inbox"],
            lambda b: f"- {_fmt_task(b)}" + (f", captured {b['created']}" if b.get("created") else ""))
    out.insert(len(out) - 1, f"Plus {r['queued_steps']} queued project step(s).")

    def wait_line(b):
        age = "no waiting_since" if b["age_days"] is None else f"{b['age_days']}d"
        flag = " **chase, wait, or drop?**" if b["stale"] else ""
        on = f" on [[{b['waiting_on']}]]" if b.get("waiting_on") else ""
        since = f" since {b['waiting_since']}" if b.get("waiting_since") else ""
        return f"- {age}: [[{b['slug']}]] {b['title']}, waiting{on}{since}{flag}"
    section("Waiting for", r["waiting"], wait_line)

    def rule_line(x):
        s = f"- [[{x['slug']}]] ({x['phase']}): {x['problem']}"
        if x["next_actions"]:
            s += " — " + ", ".join(f"[[{t}]]" for t in x["next_actions"])
        if x.get("promote"):
            s += f". Promote [[{x['promote']}]]"
        return s
    section("Projects breaking the next-action rule", r["project_rule"], rule_line)

    section("Blocked tasks ready to promote (all blockers closed)", r["promote"],
            lambda b: f"- {_fmt_task(b)}; was blocked by " + ", ".join(f"[[{x}]]" for x in b["blocked_by"]))

    st = r["stale_projects"]
    section(f"Stale in-progress projects (no task change in {STALE_DAYS}+ days, from {st['source']})",
            st["items"], lambda x: f"- [[{x['slug']}]] {x['title']}: last change "
            + (f"{x['last_change']} ({x['age_days']}d ago)" if x["last_change"] else "unknown")
            + f", {x['tasks']} task(s). Still active?")

    section("Closed but not archived", r["closed_not_archived"],
            lambda x: f"- {x['path']} ({x['status']}" + (f", completed {x['completed']})" if x["completed"] else ", no completed date)"))

    section("Someday/maybe revisits due", r["revisit"],
            lambda x: f"- [[{x['area']}]] (revisit {x['revisit']}): {x['text']}")
    return "\n".join(out).rstrip() + "\n"


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def _selected(rel: str, selected: set) -> bool:
    return any(rel == s or rel.startswith(s.rstrip("/") + "/") for s in selected)


def run_checks(v: Vault, only: Optional[list]) -> list:
    findings = []
    for cid, (_, fn) in CHECKS.items():
        if (only and cid not in only) or check_off(cid, v.cfg):
            continue
        findings.extend(fn(v))
    findings.sort(key=lambda f: (list(CHECKS).index(f.check), f.path, f.line, SEVERITY_RANK[f.severity]))
    return findings


def print_human(findings: list, quiet: bool, out=sys.stdout):
    shown = [f for f in findings if not quiet or f.severity == ERROR]
    current = None
    for f in shown:
        if f.check != current:
            current = f.check
            out.write(f"\n== {f.check}\n")
        loc = f"{f.path}:{f.line}" if f.line else f.path
        fix = " [fixable]" if f.fixable else ""
        out.write(f"{loc}: {f.severity}: {f.message}{fix}\n")
    out.write("\nSummary\n")
    out.write(f"  {'check':<22}{'error':>7}{'warning':>9}{'info':>7}\n")
    tot = {ERROR: 0, WARNING: 0, INFO: 0}
    for cid in CHECKS:
        c = {s: sum(1 for f in findings if f.check == cid and f.severity == s) for s in tot}
        for s in tot:
            tot[s] += c[s]
        if any(c.values()):
            out.write(f"  {cid:<22}{c[ERROR]:>7}{c[WARNING]:>9}{c[INFO]:>7}\n")
    out.write(f"  {'total':<22}{tot[ERROR]:>7}{tot[WARNING]:>9}{tot[INFO]:>7}\n")
    fixable = sum(1 for f in findings if f.fixable)
    if fixable:
        out.write(f"  {fixable} finding(s) fixable with --fix\n")


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="vault-lint", description=__doc__.split("\n\n")[0],
                                 epilog=__doc__.split("\n\n", 1)[1],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="*")
    ap.add_argument("--fix", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--only")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--root", default=str(Path(__file__).resolve().parent.parent))
    ap.add_argument("--today")
    ap.add_argument("--list-checks", action="store_true")
    ap.add_argument("--review", action="store_true")
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--no-git", action="store_true")
    ap.add_argument("--archive-closed", action="store_true")
    ap.add_argument("--promote", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)

    if a.list_checks:
        cfg = load_config(Path(a.root).resolve())
        for cid, (desc, _) in CHECKS.items():
            off = check_off(cid, cfg)
            print(f"{cid:<22}{desc}" + (f" (off: {off})" if off else ""))
        return 0
    only = [c.strip() for c in a.only.split(",")] if a.only else None
    global HASH_MANIFEST
    HASH_MANIFEST = only == ["manifest"]
    if only:
        bad = [c for c in only if c not in CHECKS]
        if bad:
            print(f"vault-lint: unknown check(s): {', '.join(bad)}; see --list-checks", file=sys.stderr)
            return 2
    root = Path(a.root).resolve()
    try:
        today = dt.date.fromisoformat(a.today) if a.today else dt.date.today()
    except ValueError:
        print(f"vault-lint: --today must be YYYY-MM-DD, got {a.today}", file=sys.stderr)
        return 2
    acts = a.archive_closed or a.promote
    if a.dry_run and not acts:
        print("vault-lint: --dry-run goes with --archive-closed or --promote", file=sys.stderr)
        return 2
    if acts and (a.review or a.only):
        print("vault-lint: --archive-closed and --promote take no --review or --only", file=sys.stderr)
        return 2
    if a.review:
        if a.fix or a.only or a.paths:
            print("vault-lint: --review takes no paths, --fix or --only", file=sys.stderr)
            return 2
        r = build_review(Vault(root, today), a.days, use_git=not a.no_git)
        if a.json:
            json.dump(r, sys.stdout, indent=1, ensure_ascii=False)
            sys.stdout.write("\n")
        else:
            sys.stdout.write(render_review(r))
        return 0
    selected = None
    if a.paths:
        selected = set()
        for p in a.paths:
            ap_ = Path(p)
            ap_ = ap_.resolve() if ap_.is_absolute() or ap_.exists() else (root / p).resolve()
            try:
                selected.add(str(ap_.relative_to(root)).replace(os.sep, "/").rstrip("/") or ".")
            except ValueError:
                print(f"vault-lint: {p} is outside the vault {root}", file=sys.stderr)
                return 2
        if "." in selected:
            selected = None

    vault = Vault(root, today)
    if acts:
        stream = sys.stderr if a.json else sys.stdout
        moved_to = []
        if a.archive_closed:
            r_ = archive_closed(vault, selected, a.dry_run)
            print_archive_report(r_, a.dry_run, stream)
            moved_to = [m["to"] for m in r_["moved"]]
            if r_["moved"] and not a.dry_run:
                vault = Vault(root, today)   # the next step sees the moved files
        if a.promote:
            r_ = promote(vault, selected, a.dry_run)
            print_promote_report(r_, a.dry_run, stream)
            if r_["promoted"] and not a.dry_run:
                moved_to += [m["path"] for m in r_["promoted"]]
                vault = Vault(root, today)
        if a.dry_run:
            return 0
        if moved_to:                             # key order and layout of what we wrote
            for rel, changes in apply_fixes(vault, set(moved_to)):
                stream.write(f"fixed {rel}: {'; '.join(changes)}\n")
            vault = Vault(root, today)
    if a.fix:
        report = apply_fixes(vault, selected)
        stream = sys.stderr if a.json else sys.stdout
        changed = [r_ for r_ in report if not r_[1][0].startswith("skipped")]
        for rel, changes in report:
            verb = "skipped" if changes[0].startswith("skipped") else "fixed"
            stream.write(f"{verb} {rel}: {'; '.join(changes)}\n")
        stream.write(f"--fix: {len(changed)} file(s) changed\n")
        if report:
            vault = Vault(root, today)

    findings = run_checks(vault, only)
    if selected is not None:
        findings = [f for f in findings if _selected(f.path.rstrip("/"), selected)]
    if a.json:
        json.dump([f.as_dict() for f in findings], sys.stdout, indent=1, ensure_ascii=False)
        sys.stdout.write("\n")
    else:
        print_human(findings, a.quiet)
    return 1 if any(f.severity == ERROR for f in findings) else 0


if __name__ == "__main__":
    sys.exit(main())
