@check("dates", "dates are plausible: nothing completed, created or handed off in the future")
def check_dates(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.is_note or not n.fm:
            continue
        d = {k: parse_date(n.fm.scalar(k) or "") for k in DATE_FIELDS}
        line = lambda k: n.fm.get(k).line  # noqa: E731
        if d["completed"] and d["completed"] > v.today:
            yield Finding("dates", ERROR, n.rel, line("completed"), f"'completed' {d['completed']} is in the future")
        if d["created"] and d["created"] > v.today:
            yield Finding("dates", WARNING, n.rel, line("created"), f"'created' {d['created']} is in the future")
        if d["waiting_since"] and d["waiting_since"] > v.today:
            yield Finding("dates", WARNING, n.rel, line("waiting_since"),
                          f"'waiting_since' {d['waiting_since']} is in the future")
        if d["created"] and d["completed"] and d["completed"] < d["created"]:
            yield Finding("dates", WARNING, n.rel, line("completed"), "'completed' is before 'created'")
        for k in ("due", "created", "completed", "waiting_since", "date"):
            if d[k] and not (2000 <= d[k].year <= v.today.year + 20):
                yield Finding("dates", WARNING, n.rel, line(k), f"'{k}' {d[k]} looks like a typo")


