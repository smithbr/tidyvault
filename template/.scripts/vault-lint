DV_KEYWORDS = {"table", "list", "task", "calendar", "without", "id", "from", "where", "sort",
               "group", "by", "flatten", "limit", "asc", "desc", "ascending", "descending",
               "and", "or", "not", "as", "true", "false", "null"}
DV_IMPLICIT = {"file", "this", "row", "rows", "key", "today", "now", "tomorrow", "yesterday",
               "sow", "eow", "som", "eom", "soy", "eoy", "Infinity"}
DV_FENCE = re.compile(r"^ {0,3}(```|~~~)\s*dataview\s*$")
DVJS_FENCE = re.compile(r"^ {0,3}(```|~~~)\s*dataviewjs\b")
DVJS_INLINE = re.compile(r"`\$=\s*[^`\s]")  # an inline DataviewJS query: `$= expression`
DVJS_HOME = "Home.md"  # the one note allowed to run any DataviewJS
VIEWS_DIR = "Agents/views"  # shared Dataview view scripts: <name>/view.js and view.css (Agents/body-sections.md)
# The one DataviewJS block any note may hold: a call to one of the vault's own views in
# Agents/views/<name>/, with string options only.
DVJS_VIEW_CALL = re.compile(r'^await dv\.view\("Agents/views/[a-z0-9]+(?:-[a-z0-9]+)*"'
                            r'(, \{\s*(?:\w+:\s*"[^"\\]*"\s*(?:,\s*\w+:\s*"[^"\\]*"\s*)*)?\})?\);?$')


def dvjs_blocks(lines):
    """Yield (fence line index, body lines, allowed) for each dataviewjs block; allowed = a view call."""
    i = 0
    while i < len(lines):
        m = DVJS_FENCE.match(lines[i])
        if not m:
            i += 1
            continue
        j = i + 1
        while j < len(lines) and lines[j].strip() != m.group(1):
            j += 1
        body = [l for l in lines[i + 1:j] if l.strip()]
        yield i, body, len(body) == 1 and bool(DVJS_VIEW_CALL.match(body[0].strip()))
        i = j + 1


def all_schema_fields() -> set:
    names = {n for n, _ in COMMON_HEAD + COMMON_TAIL + ARCHIVE_EXTRA + MANUAL_FIELDS}
    for fields in FOLDER_FIELDS.values():
        names |= {n for n, _ in fields}
    return names


def dataview_identifiers(query: str) -> Iterator[tuple]:
    """Yield (line offset, name) for bare field references in a DQL query."""
    known_local = set()
    for qi, qline in enumerate(query.split("\n")):
        s = re.sub(r'"(?:[^"\\]|\\.)*"', '""', qline)           # string literals
        s = re.sub(r"\[\[[^\]]*\]\]", " ", s)                     # link literals
        s = re.sub(r"#[\w/-]+", " ", s)                            # tag sources
        s = re.sub(r"\b(dur|date)\(([^()]*)\)", r"\1()", s, flags=re.I)  # dur(2 days)
        for m in re.finditer(r"\(([^()]*)\)\s*=>|\b([A-Za-z_]\w*)\s*=>", s):
            known_local |= set(re.findall(r"[A-Za-z_]\w*", m.group(1) or m.group(2)))
        for m in re.finditer(r"\bAS\s+([A-Za-z_]\w*)", s, flags=re.I):
            known_local.add(m.group(1))
        for m in re.finditer(r"(?<![\w.\-])([A-Za-z_][\w-]*[\w]|[A-Za-z_])", s):
            name = m.group(1)
            rest = s[m.end():]
            if re.match(r"\s*\(", rest) or re.match(r"\s*=>", rest):
                continue  # function call or lambda parameter
            if name.lower() in DV_KEYWORDS or name in known_local:
                continue
            yield qi, name


@check("dataview", "Dataview blocks use schema fields and existing FROM folders")
def check_dataview(v: Vault) -> Iterator[Finding]:
    fields = all_schema_fields() | DV_IMPLICIT
    folders = set(v.dirs)
    for n in v.notes.values():
        if not n.is_note and n.folder != "Stray":
            continue
        lines = n.body.split("\n")
        i = 0
        while i < len(lines):
            m = DV_FENCE.match(lines[i])
            if not m:
                i += 1
                continue
            start = i + 1
            j = start
            while j < len(lines) and lines[j].strip() != m.group(1):
                j += 1
            query = "\n".join(lines[start:j])
            base = n.body_start_line + start
            reported = set()
            for off, name in dataview_identifiers(query):
                if name not in fields and name not in reported:
                    reported.add(name)
                    yield Finding("dataview", WARNING, n.rel, base + off,
                                  f"Dataview query uses '{name}', which is not a schema field")
            for off, qline in enumerate(query.split("\n")):
                fm_ = re.match(r"^\s*FROM\s+(.*)$", qline, re.I)
                if fm_:
                    for src in re.findall(r'"([^"]+)"', fm_.group(1)):
                        s = src.strip("/")
                        if s not in folders and v.by_path.get(s.lower()) is None:
                            yield Finding("dataview", WARNING, n.rel, base + off,
                                          f"Dataview FROM \"{src}\" is not a folder or note in the vault")
            i = j + 1


@check("dataviewjs", "DataviewJS runs code when a note opens: only Home.md may have it, except a one-line call to a view in Agents/views/; drop folders are scanned too")
def check_dataviewjs(v: Vault) -> Iterator[Finding]:
    def hits(text, allow_view=False):
        lines = text.split("\n")
        for i, body, allowed in dvjs_blocks(lines):
            if not (allow_view and allowed):
                yield i + 1, "dataviewjs block"
        for i, line in enumerate(lines):
            if DVJS_INLINE.search(line):
                yield i + 1, "inline DataviewJS query (`$=`)"
    for n in v.notes.values():
        if n.rel == DVJS_HOME:
            continue
        for ln, what in hits(n.text, allow_view=True):
            yield Finding("dataviewjs", ERROR, n.rel, ln,
                          f"{what}: only {DVJS_HOME} may run DataviewJS, or a one-line Agents/views/<name> call "
                          f"(Agents/body-sections.md); use a DQL 'dataview' block, or fence it as text")
    # Notes waiting in the drop folders aren't indexed, but Obsidian runs their code if they're opened.
    for top in (IMPORTS_DIR, CAPTURES_DIR):
        for dirpath, dirnames, filenames in os.walk(v.root / top):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for fn in sorted(filenames):
                if not fn.lower().endswith(".md"):
                    continue
                path = Path(dirpath) / fn
                try:
                    text = path.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                rel = path.relative_to(v.root).as_posix()
                for ln, what in hits(text):
                    yield Finding("dataviewjs", WARNING, rel, ln,
                                  f"{what} in a drop-folder note: don't open it in Obsidian; the importer fences it as text before filing")


