                break


# Body formatting: the vault-safe subset of the Obsidian Linter rules enabled in
# .obsidian/plugins/obsidian-linter (Agents/obsidian-settings.md), so agent edits
# match what the Linter produces on save. Fenced code (incl. Dataview) is untouched.
_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
_HEADING = re.compile(r"^#{1,6}(\s|$)")
_HR = re.compile(r"^ {0,3}([-*_])( *\1){2,} *$")
_ALT_BULLET = re.compile(r"^(\s*)[*+•](?=\s)(?!\s*$)")
_OL_PAREN = re.compile(r"^(\s*)(\d+)\)(?=\s)")
_OL_ITEM = re.compile(r"^(\s*)(\d+)\.(?=\s)")
_HEADING_PARTS = re.compile(r"^(#{1,6})(\s+|$)(.*?)$")  # bare "#": an empty heading (a fresh capture)
_HEADING_PUNCT = ".,;:!"
# spans the Linter's quote-style rule leaves alone
_QUOTE_SKIP = re.compile(r"`[^`]*`|<%.*?%>|!?\[\[[^\]]*\]\]|!?\[[^\]]*\]\([^)]*\)|<[^>\n]+>|\$[^$\n]+\$")
_CURLY = str.maketrans({"\u2018": "'", "\u2019": "'", "\u201c": '"', "\u201d": '"'})


def _straight_quotes(line: str) -> str:
    out, pos = [], 0
    for m in _QUOTE_SKIP.finditer(line):
        out.append(line[pos:m.start()].translate(_CURLY))
        out.append(m.group(0))
        pos = m.end()
    out.append(line[pos:].translate(_CURLY))
    return "".join(out)


def _header_increment(levels: list) -> list:
    """Port of the Obsidian Linter's header-increment rule (start-at-h2 off)."""
    prev, stack, a, out = 0, [], [0] * 6, []
    for f in levels:
        f = min(f, 6)
        if a[f - 1] >= 0 and f < prev:
            h = len(a)
            while stack and f <= stack[-1]:
                h = stack.pop()
            h = 0 if not stack else h - 1
            for g in range(len(a) - 1, h - 1, -1):
                a[g] = 0
        if a[f - 1] <= 0:
            g = min(len(stack) + 1, 6)
            for v in range(prev, f - 1):
                a[v] = g - 1
            stack.append(f)
            a[f - 1] = g
        prev = f
        out.append(a[f - 1])
    return out


def format_body(body: str) -> tuple:
    """(new body, [changes]) for a note body (text after the closing ---)."""
    changes = []
    lines = body.split("\n")
    # classify lines: (text, kind) kind in fence|heading|table|quote|blank|text
    out, in_fence, fence_char = [], False, ""
    for line in lines:
        m = _FENCE.match(line)
        if in_fence:
            out.append([line, "fence"])
            if m and m.group(1)[0] == fence_char and line.strip().startswith(fence_char * 3):
                in_fence = False
            continue
        if m:
            in_fence, fence_char = True, m.group(1)[0]
            if line.strip() == m.group(1):
                line = line.rstrip() + "text"
                changes.append("code fence language 'text'")
            out.append([line, "fence"])
            continue
        stripped = line.rstrip()
        if stripped != line:
            changes.append("trailing spaces")
            line = stripped
        if not _HR.match(line):
            nb = _ALT_BULLET.sub(r"\1-", line)
            if nb != line:
                changes.append("list markers to '-'")
                line = nb
        nb = _OL_PAREN.sub(r"\1\2.", line)
        if nb != line:
            changes.append("ordered list markers to '.'")
            line = nb
        nb = _straight_quotes(line)
        if nb != line:
            changes.append("straight quotes")
            line = nb
        hm = _HEADING_PARTS.match(line)
        if hm and hm.group(3).rstrip().rstrip(_HEADING_PUNCT) != hm.group(3).rstrip():
            line = hm.group(1) + hm.group(2) + hm.group(3).rstrip().rstrip(_HEADING_PUNCT)
            changes.append("heading trailing punctuation")
        kind = ("blank" if not line.strip() else "heading" if _HEADING.match(line)
                else "table" if line.lstrip().startswith("|") else "quote" if line.lstrip().startswith(">")
                else "text")
        out.append([line, kind])
    heads = [k for k, (l, kind) in enumerate(out) if kind == "heading"]
    fixed = _header_increment([len(_HEADING_PARTS.match(out[k][0]).group(1)) for k in heads])
    for k, lvl in zip(heads, fixed):
        cur = _HEADING_PARTS.match(out[k][0])
        if len(cur.group(1)) != lvl:
            out[k][0] = "#" * lvl + cur.group(2) + cur.group(3)
            changes.append("heading levels increment by one")
    # ordered lists: consecutive items at one indent count up from the first number (no blank-line gaps)
    run_indent, n = None, 0
    for row in out:
        if row[1] != "text":
            run_indent = None
            continue
        om = _OL_ITEM.match(row[0])
        if om and (run_indent is None or om.group(1) == run_indent):
            n = int(om.group(2)) if run_indent is None else n + 1  # preserve-start
            run_indent = om.group(1)
            if int(om.group(2)) != n:
                row[0] = f"{om.group(1)}{n}." + row[0][om.end():]
                changes.append("ordered list numbering")
        elif not (run_indent is not None and row[0].startswith(run_indent + " ")):
            run_indent = None
    pre_pad = re.sub(r"\n{3,}", "\n\n", "\n".join(l for l, _ in out)).strip("\n")
    # group consecutive fence/table/quote lines into blocks; headings are 1-line blocks
    blocks, i = [], 0
    while i < len(out):
        kind = out[i][1]
        j = i + 1
        if kind == "fence":
            # a fence block runs until its closing fence line
            opener = _FENCE.match(out[i][0]).group(1)[0]
            while j < len(out) and out[j][1] == "fence":
                if out[j][0].strip().startswith(opener * 3) and _FENCE.match(out[j][0]):
                    j += 1
                    break
                j += 1
        elif kind in ("table", "quote", "text", "blank"):
            while j < len(out) and out[j][1] == kind:
                j += 1
        blocks.append((kind, [l for l, _ in out[i:j]]))
        i = j
    # rebuild: padded kinds get one blank line before and after; runs of blanks collapse
    result = []
    padded = {"fence", "heading", "table", "quote"}
    for idx, (kind, blines) in enumerate(blocks):
        if kind == "blank":
            if result and result[-1] != "":
                result.append("")
            continue
        if kind in padded and result and result[-1] != "":
            result.append("")
        if kind not in padded and result and result[-1] != "" and _prev_padded(blocks, idx):
            result.append("")
        result.extend(blines)
    new = "\n".join(result).strip("\n")
    new = new + "\n" if new else ""
    if new != body:
        if "\n\n\n" in body:
            changes.append("consecutive blank lines")
        if not body.endswith("\n") or body.endswith("\n\n"):
            changes.append("single newline at end of file")
        if body.startswith("\n"):
            changes.append("blank line after the frontmatter")
        if pre_pad != new.strip("\n"):
            changes.append("blank lines around headings, code fences, tables, or blockquotes")
    return new, list(dict.fromkeys(changes))


def _prev_padded(blocks, idx) -> bool:
    for kind, _ in reversed(blocks[:idx]):
        if kind == "blank":
            return False
        return kind in {"fence", "heading", "table", "quote"}
    return False


def _formattable(n) -> bool:
    return bool(n.is_note and n.fm and not n.fm.unsafe and n.fixable_file and not n.is_template
                and not n.crlf and n.folder not in ("Home",) or (n.is_note and n.fm and n.folder == "Home"
                and not n.fm.unsafe and n.fixable_file and not n.crlf))


@check("format", "body spacing and list markers match the Obsidian Linter rules (fix with --fix)")
def check_format(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not _formattable(n):
            continue
        body = n.text[n.fm.body_offset:]
        new, changes = format_body(body)
        if new != body:
            yield Finding("format", WARNING, n.rel, n.fm.end_line + 1,
                          "formatting: " + ", ".join(changes), fixable=True)


@check("orphans", "Resources nothing links to")
def check_orphans(v: Vault) -> Iterator[Finding]:
    for r in v.content_notes("Resources"):
        if not v.refs.get(r.rel):
            yield Finding("orphans", INFO, r.rel, 0, "no note links to this resource")


FALSE_FACTS = "Resources/false-facts.md"
LIVE_FOLDERS = ("Tasks", "Projects", "Areas", "Resources", "People", "Home")
CURRENT_WORDS = re.compile(r"(?i)\b(currently|right now|still|as of)\b")
# Citations (Agents/linking.md, Citations): a fact line ends "([[source-page]])" or "(<source>, YYYY-MM-DD[, [[run-log]]])".
CITATION = re.compile(r"\((?=[^()]*(?:\[\[|\b\d{4}-\d{2}-\d{2}\b))[^()]*\)\s*\.?\s*$")
# Key facts lines already in the baseline commit are legacy; later ones need a citation. The baseline is
# VAULT_LINT_CITE_BASELINE, or the vault's first commit (so a fresh vault cites everything from day one).
CITE_BASELINE = os.environ.get("VAULT_LINT_CITE_BASELINE", "")
YEAR = re.compile(r"\b(19\d\d|20\d\d)\b")


def _banned_patterns(v: Vault) -> Iterator[tuple]:
    """(line, claim, compiled regex or None) per row of false-facts' Banned claims table."""
    n = v.notes.get(FALSE_FACTS)
    if not n:
        return
    cols, section = None, ""
    for ln, line in enumerate(n.body.split("\n"), n.body_start_line):  # raw: patterns sit in `code`
        if line.startswith("## "):
            section, cols = line[3:].strip(), None
            continue
        if section != "Banned claims" or not line.lstrip().startswith("|"):
            continue
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", line.strip().strip("|"))]
        if cols is None:
            cols = [c.lower() for c in cells]
            continue
        if set("".join(cells)) <= set("-: "):
            continue
        row = dict(zip(cols, cells))
        pat = row.get("search", "").strip("`").strip().replace("\\|", "|")
        try:
            yield ln, row.get("claim", ""), re.compile(pat, re.I) if pat else None
        except re.error as e:
            yield ln, row.get("claim", ""), e


@check("facts", "Resources and People: banned claims from false-facts, dated facts worded as current, "
                "people named but not linked, Key facts added since the citation baseline without a citation "
                "(Agents/roles/role-vault-docs.md, Check)")
def check_facts(v: Vault) -> Iterator[Finding]:
    # High: a banned claim is back in a live note.
    pats = []
    for ln, claim, rx in _banned_patterns(v):
        if rx is None:
            yield Finding("facts", INFO, FALSE_FACTS, ln, f"no Search pattern, so lint can't catch: {claim[:60]}")
        elif isinstance(rx, re.error):
            yield Finding("facts", ERROR, FALSE_FACTS, ln, f"bad Search regex: {rx}")
        else:
            pats.append((claim, rx))
    for n in v.content_notes(*LIVE_FOLDERS):
        hits = [(c, rx) for c, rx in pats if rx.search(n.text)]
        if n.rel == FALSE_FACTS or n.is_template or not hits:
            continue
        for ln, line in enumerate(n.text.split("\n"), 1):
            for claim, rx in hits:
                if rx.search(line):
                    yield Finding("facts", ERROR, n.rel, ln, f"banned claim ([[false-facts]]): {claim[:60]}")
    # Medium: a Key fact worded as current but dated before last year.
    for p in v.content_notes("People"):
        in_kf = False
        for ln, line in body_lines_outside_code(p):
            if line.startswith("## "):
                in_kf = line.strip() == "## Key facts"
                continue
            if in_kf and CURRENT_WORDS.search(line):
                years = [int(y) for y in YEAR.findall(line)]
                if years and max(years) < v.today.year - 1:
                    yield Finding("facts", INFO, p.rel, ln,
                                  f"worded as current but dated {max(years)}; still true?")
    # Info: a Key facts line added since CITE_BASELINE with no citation.
    yield from _uncited_key_facts(v)
    # Low: a person named in full but not linked from the file.
    people = {p.title: p.rel for p in v.content_notes("People")
              if p.title and " " in p.title and p.stem != v.cfg["owner_slug"]}
    if not people:
        return
    names = re.compile(r"\b(" + "|".join(map(re.escape, sorted(people, key=len, reverse=True))) + r")\b")
    for n in list(v.content_notes("Resources")) + list(v.content_notes("People")):
        if n.stem == "pii-register" or not names.search(n.body):
            continue
        seen = set()
        for ln, line in body_lines_outside_code(n):
            for m in names.finditer(line):
                name, rel = m.group(1), people[m.group(1)]
                if name in seen or rel == n.rel or n.rel in v.refs.get(rel, {}):
                    continue
                seen.add(name)
                yield Finding("facts", INFO, n.rel, ln, f"names {name} but never links [[{Path(rel).stem}]]")


def _key_fact_lines(n: Note) -> Iterator[tuple]:
    in_kf, raw = False, n.text.split("\n")
    for ln, line in body_lines_outside_code(n):
        if line.startswith("#"):
            in_kf = line.strip() == "## Key facts"
        elif in_kf and re.match(r"\s*(?:[-*+]|\d+\.)\s+\S", line):
            yield ln, raw[ln - 1]


def _baseline_texts(root: Path, stems: set) -> Optional[dict]:
    """stem -> file text at CITE_BASELINE (People, Resources, Archive); None when git or the commit is missing."""
    import subprocess
    try:
        top = subprocess.run(["git", "-C", str(root), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10)
        if top.returncode != 0 or Path(top.stdout.strip()).resolve() != root.resolve():
            return None
        baseline = CITE_BASELINE
        if not baseline:
            first = subprocess.run(["git", "-C", str(root), "rev-list", "--max-parents=0", "HEAD"],
                                   capture_output=True, text=True, timeout=10)
            baseline = first.stdout.split()[0] if first.returncode == 0 and first.stdout.split() else ""
            if not baseline:
                return None
        tree = subprocess.run(["git", "-C", str(root), "-c", "core.quotepath=off", "ls-tree", "-r",
                               baseline, "--", "People", "Resources", "Archive"],
                              capture_output=True, text=True, timeout=30)
        if tree.returncode != 0:
            return None
        blobs = {}
        for line in tree.stdout.split("\n"):
            meta, _, path = line.partition("\t")
            stem = Path(path).stem
            if path.endswith(".md") and stem in stems:
                blobs[meta.split()[2]] = stem
        if not blobs:
            return {}
        cat = subprocess.run(["git", "-C", str(root), "cat-file", "--batch"], input=("\n".join(blobs) + "\n").encode(),
                             capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    out, data, i = {}, cat.stdout, 0
    while i < len(data):
        nl = data.index(b"\n", i)
        head = data[i:nl].split()
        if len(head) < 3:  # "<sha> missing"
            i = nl + 1
            continue
        size = int(head[2])
        out[blobs.get(head[0].decode(), "")] = data[nl + 1:nl + 1 + size].decode("utf-8", "replace")
        i = nl + 1 + size + 1
    return out


def _uncited_key_facts(v: Vault) -> Iterator[Finding]:
    cand = {}
    for n in list(v.content_notes("People")) + list(v.content_notes("Resources")):
        if n.is_template:
            continue
        lines = [(ln, line) for ln, line in _key_fact_lines(n) if not CITATION.search(line)]
        if lines:
            cand[n.rel] = (n, lines)
    if not cand:
        return
    base = _baseline_texts(v.root, {n.stem for n, _ in cand.values()})
    if base is None:
        return
    for n, lines in cand.values():
        old = {l.strip() for l in base.get(n.stem, "").split("\n")}
        for ln, line in lines:
            if line.strip() not in old:
                yield Finding("facts", INFO, n.rel, ln, "Key fact added since the citation baseline has no citation "
                                                       "([[linking#Citations]])")


@check("source-urls", "URLs of read-only source systems (lint.read_only_url_patterns): error in frontmatter, info in body")
def check_source_urls(v: Vault) -> Iterator[Finding]:
    patterns = []
    for p in v.cfg["read_only_url_patterns"]:
        try:
            patterns.append(re.compile(p, re.I))
        except re.error as e:
            yield Finding("source-urls", WARNING, CONFIG_FILE, 0, f"bad read_only_url_patterns regex {p!r}: {e}")
    if not patterns:
        return
    for n in v.notes.values():
        fm_end = n.fm.end_line if n.fm else 0
        for i, line in enumerate(n.text.split("\n")):
            if n.is_template and i + 1 > fm_end:
                break
            if any(p.search(line) for p in patterns):
                if i + 1 <= fm_end:
                    yield Finding("source-urls", ERROR, n.rel, i + 1, "read-only source URL in frontmatter")
                else:
                    yield Finding("source-urls", INFO, n.rel, i + 1, "read-only source URL in body")


