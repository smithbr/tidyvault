@check("structure", "allowed top-level folders/files, templates, roles and logs in Agents/, attachments only in _attachments/")
def check_structure(v: Vault) -> Iterator[Finding]:
    for d in v.dirs:
        parts = d.split("/")
        if parts[0] == ATTACH_DIR:
            continue
        if len(parts) == 1 and parts[0] not in ALLOWED_DIRS:
            yield Finding("structure", ERROR, d + "/", 0,
                          f"top-level folder '{d}' is not allowed (only {', '.join(sorted(ALLOWED_DIRS))})")
    for f in v.files:
        parts = f.split("/")
        if parts[0] == ATTACH_DIR or (parts[0] not in ALLOWED_DIRS and len(parts) > 1):
            continue  # attachments fine; disallowed top dirs already reported
        if len(parts) == 1:
            if f not in ROOT_FILES:
                yield Finding("structure", ERROR, f, 0,
                              f"file not allowed at vault root (only {', '.join(sorted(ROOT_FILES))})")
            continue
        if not f.endswith(".md"):
            if re.fullmatch(VIEWS_DIR + r"/[a-z0-9-]+/view\.(js|css)", f):
                continue  # a shared Dataview view script (Agents/body-sections.md, Task status view)
            yield Finding("structure", ERROR, f, 0,
                          f"non-note file outside _attachments/; move it there (view scripts: {VIEWS_DIR}/<name>/view.js)")
            continue
        for prefix, home in (("template-", TEMPLATE_DIR), ("role-", ROLE_DIR), ("log-", LOG_DIR)):
            if parts[0] == "Agents" and parts[-1].startswith(prefix) and "/".join(parts[:-1]) != home:
                if prefix == "role-" and "/".join(parts[:-1]) == LOCAL_ROLE_DIR and parts[-1].endswith("-local.md"):
                    continue  # a vault's own additions to a kit role (Agents/README.md, Kit-managed pages)
                where = f"{home}/" + (f" (a vault's additions to a role: {LOCAL_ROLE_DIR}/role-<name>-local.md)" if prefix == "role-" else "")
                yield Finding("structure", ERROR, f, 0, f"{prefix}*.md notes live in {where}")


@check("file-format", "UTF-8 without BOM, LF line endings, readable size, no symlinks")
def check_file_format(v: Vault) -> Iterator[Finding]:
    for rel in v.symlinks:
        yield Finding("file-format", WARNING, rel, 0,
                      "symlink; sync and backup may not carry it, and vault-lint does not follow it")
    for n in v.notes.values():
        if n.bad_utf8:
            yield Finding("file-format", ERROR, n.rel, 0,
                          "not valid UTF-8 (or unreadable); re-save as UTF-8. --fix skips it")
        if n.too_large:
            yield Finding("file-format", WARNING, n.rel, 0,
                          f"larger than {MAX_NOTE_BYTES // 1_000_000} MB; content checks skipped. "
                          "Large content belongs in _attachments/")
        if n.bom:
            yield Finding("file-format", WARNING, n.rel, 1,
                          "UTF-8 byte-order mark before the frontmatter", n.fm is not None and not n.fm.unsafe)
        if n.crlf:
            yield Finding("file-format", WARNING, n.rel, 0,
                          "CRLF (Windows) line endings; save with LF. --fix keeps them as they are")


@check("frontmatter-present", "every note opens with a closed --- frontmatter block")
def check_frontmatter_present(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if n.is_note and n.fm is None and not n.too_large:
            yield Finding("frontmatter-present", ERROR, n.rel, 1, n.fm_error or "no frontmatter")


FIX_TAGS = {"quote-link", "block-list", "drop-empty", "drop-blank", "indent", "drop-empty-item"}


@check("frontmatter-syntax", "frontmatter stays inside the restricted YAML subset; key order")
def check_frontmatter_syntax(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.fm or not (n.is_note or n.folder == "Stray"):
            continue
        for iss in n.fm.issues:
            yield Finding("frontmatter-syntax", iss.severity, n.rel, iss.line, iss.message,
                          iss.fix in FIX_TAGS and not n.fm.unsafe)
        if not n.is_note:
            continue
        fields = dict(schema_for(n))
        for e in n.fm.entries:
            if e.key in DATE_FIELDS and e.kind == "scalar" and e.value.style == "double" \
                    and ISO_DATE.match(e.value.text):
                yield Finding("frontmatter-syntax", WARNING, n.rel, e.line,
                              f"quoted date in '{e.key}'; write it unquoted", not n.fm.unsafe)
        order = [name for name, _ in schema_for(n)]
        known = [e.key for e in n.fm.entries if e.key in fields]
        expected = sorted(known, key=order.index)
        if known != expected:
            first = next(i for i, (a, b) in enumerate(zip(known, expected)) if a != b)
            e = n.fm.get(known[first])
            yield Finding("frontmatter-syntax", WARNING, n.rel, e.line,
                          f"keys out of schema order; expected: {', '.join(expected)}", not n.fm.unsafe)


@check("filename", "kebab-case filename equal to slug(title); no emoji")
def check_filename(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.is_note or n.rel in FILENAME_EXCEPTIONS:
            continue
        if has_emoji(n.stem):
            yield Finding("filename", ERROR, n.rel, 0, "emoji in filename")
        if not KEBAB.match(n.stem):
            yield Finding("filename", ERROR, n.rel, 0, "filename is not kebab-case")
            continue
        if n.stem.lower().startswith("untitled"):
            yield Finding("filename", WARNING, n.rel, 0, "'Untitled' note; give it a title and file it")
        if n.folder == "Archive" and n.stem.startswith("archived-"):
            yield Finding("filename", WARNING, n.rel, 0, "Archive filenames take no 'archived-' prefix")
        t = n.title
        if t and slugify(t) != n.stem and not n.is_template:  # templates are named template-<kind>
            yield Finding("filename", WARNING, n.rel, 0,
                          f"filename differs from slug of title ('{slugify(t)}.md')")


def _link_key(rel: str) -> str:
    """What a [[link]] to this file is matched on: note stem, or attachment filename."""
    name = rel.rsplit("/", 1)[-1].lower()
    return name[:-3] if name.endswith(".md") else name


@check("unique-names", "every note/attachment basename is unique vault-wide (case-insensitive)")
def check_unique_names(v: Vault) -> Iterator[Finding]:
    groups: dict = {}
    for rel in v.files:
        if rel.startswith(RAW_DIR + "/") and not rel.endswith(".md"):
            continue  # raw originals keep their source names, duplicates included
        groups.setdefault(_link_key(rel), []).append(rel)
    for key, rels in groups.items():
        if len(rels) < 2:
            continue
        for rel in rels:
            others = ", ".join(r for r in rels if r != rel)
            yield Finding("unique-names", ERROR, rel, 0,
                          f"basename '{key}' also used by {others}; [[{key}]] links are ambiguous")


