def _org_line(v: Vault, line: str, source: str) -> bool:
    """The line links an organization Resource, so its contact details are a business's."""
    for m in re.finditer(r"\[\[([^\]|#]+)", line):
        rel = v.resolve(m.group(1), source)
        t = v.notes.get(rel) if rel else None
        if t and t.fm and t.fm.scalar("type") == "organization":
            return True
    return False


def pii_hits(v: Vault, n) -> Iterator[tuple]:
    """(line number, label, matched text) for each PII value in a note (Agents/sensitive-data.md)."""
    # An organization, or a professional contact's Person file: its phone, email, and address are a business's.
    is_org = bool(n.fm and (n.fm.scalar("type") == "organization"
                            or (n.folder == "People" and n.fm.scalar("relationship") == "professional")))
    public = bool(n.fm and n.fm.scalar("public_places") == "true")
    for i, line in enumerate(n.text.split("\n")):
        scrubbed = _PII_SCRUB.sub(" ", _URLISH.sub(" ", line))
        for rx, label in SENSITIVE:
            m = rx.search(scrubbed)
            if m and not (label.startswith("long digit run") and _REGISTRY_LABEL.search(scrubbed[:m.start()])
                          and (is_org or _BUSINESS_LINE.search(line) or _org_line(v, line, n.rel))):
                yield i + 1, label, m.group(0)
        m = PII_DOB.search(scrubbed)
        if m and not _PET_LINE.search(line):
            yield i + 1, "date of birth", m.group(0)
        business = None  # worked out only when a contact pattern matches
        for rx, label in PII_CONTACT:
            if is_org or (public and label != "email address"):
                continue
            for m in rx.finditer(scrubbed):
                if business is None:
                    business = bool(_BUSINESS_LINE.search(line) or ("[[" in line and _org_line(v, line, n.rel)))
                if business:
                    break
                if label == "phone number" and (m.group(1) or m.group(2)) in _TOLL_FREE:
                    continue
                if label == "email address":
                    addr = m.group(0).lower()
                    allow = _pii_allowlist(v)
                    if _ROLE_MAILBOX.match(m.group(1)) or addr in allow or addr.split("@", 1)[1] in allow:
                        continue
                yield i + 1, label, m.group(0)
                break


def _pii_scope(n) -> bool:
    if not n.is_note or n.is_template or n.rel == "Resources/pii-register.md":
        return False
    return n.rel == "Home.md" or n.rel.startswith(LOG_DIR + "/") or n.folder in PII_SCOPE


@check("pii", "no PII values in notes or run logs: keys instead (Agents/sensitive-data.md)")
def check_pii(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not _pii_scope(n):
            continue
        for ln, label, text in pii_hits(v, n):
            yield Finding("pii", PII_SEVERITY, n.rel, ln,
                          f"{label} ({_mask(text)}): replace it with its key, [[pii-register#<Person>|🔒 <key>]]")


PII_KEY_LINK = re.compile(r"\[\[pii-register#[^\]]*\]\]")


@check("sensitive", "notes with PII keys carry sensitive: true")
def check_sensitive(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
