def slugify(title: str) -> str:
    """Agents/naming-and-style.md: ASCII-fold, lowercase, drop apostrophes,
    non-alphanumeric runs to '-', trim."""
    s = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
    s = s.lower().replace("'", "")
    s = re.sub(r"[^a-z0-9]+", "-", s)
    return s.strip("-")


KEBAB = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
_EMOJI = re.compile(
    "[\U0001F000-\U0001FAFF\U00002600-\U000027BF\U00002B00-\U00002BFF"
    "\U0001F1E6-\U0001F1FF\U0000FE0F\U0000200D\U00002300-\U000023FF]"
)


def has_emoji(s: str) -> bool:
    return bool(_EMOJI.search(s))


def parse_date(s: str) -> Optional[dt.date]:
    if not ISO_DATE.match(s or ""):
        return None
    if len(s) > 10 and not (int(s[11:13]) < 24 and int(s[14:16]) < 60):
        return None
    try:
        return dt.date.fromisoformat(s[:10])
    except ValueError:
        return None


def link_target(v: Value) -> Optional[str]:
    m = WIKILINK_FULL.match(v.text.strip())
    return parse_link(v.text.strip()[2:-2]) if m else None


