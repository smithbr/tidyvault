# Agents/body-sections.md: sections marked required, each holding a Dataview block.
REQUIRED_SECTIONS = {
    "Projects": ["Tasks"],
    "Areas": ["Projects", "Tasks"],
}
TEMPLATER_TAG = re.compile(r"<%[-_*+]?\s.*?%>|<%\*")  # Agents/procedures.md: only Agents/templates/ notes hold them
REVISIT = re.compile(r"\(revisit ([^)]*)\)")
# Pictographic emoji only; dingbats like ✓ → ★ are not flagged in body text.
_BODY_EMOJI = re.compile("[\U0001F000-\U0001FAFF]|[\U00002190-\U00002BFF]\U0000FE0F")
HEADING_EMOJI_LINE = re.compile(r"#{2,6}\s")  # the H1 is the title, checked by `title`


def sections(note: Note) -> dict:
    """'## Heading' -> (line, [body lines incl. fences]) for level-2 sections."""
    out, cur = {}, None
    fence = None
    for i, line in enumerate(note.body.split("\n")):
        ln = note.body_start_line + i
        m = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if m and m.group(1)[0] == fence[0] and line.strip() == m.group(1):
                fence = None
        elif m:
            fence = m.group(1)
        elif line.startswith("## "):
            cur = line[3:].strip()
            out.setdefault(cur, (ln, []))
            continue
        elif line.startswith("# "):
            cur = None
        if cur is not None:
            out[cur][1].append(line)
    return out


MANIFEST = RAW_DIR + "/manifest.tsv"  # where each filed attachment came from, one row per filed copy
MANIFEST_COLUMNS = ["sha256", "size", "filed_path", "original_path", "original_name", "imported"]
HASH_MANIFEST = False  # set by main() for `--only manifest`


@check("manifest", "every _attachments/_raw/manifest.tsv row names a filed attachment that exists, unchanged")
def check_manifest(v: Vault) -> Iterator[Finding]:
    import hashlib
    path = v.root / MANIFEST
    if not path.is_file():
        return
    lines = path.read_text(encoding="utf-8").split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if not lines or lines[0].split("\t") != MANIFEST_COLUMNS:
        yield Finding("manifest", ERROR, MANIFEST, 1, "header must be: " + " ".join(MANIFEST_COLUMNS))
        return
    store_skipped = 0
    for n, line in enumerate(lines[1:], start=2):
        cols = line.split("\t")
        if len(cols) != len(MANIFEST_COLUMNS):
            yield Finding("manifest", ERROR, MANIFEST, n, f"expected {len(MANIFEST_COLUMNS)} tab-separated columns, got {len(cols)}")
            continue
        sha, size, filed = cols[0], cols[1], cols[2]
        if not re.fullmatch(r"[0-9a-f]{64}", sha) or not size.isdigit():
            yield Finding("manifest", ERROR, MANIFEST, n, "sha256 must be 64 hex digits and size a whole number")
            continue
        f = v.root / filed
        if filed.startswith(STORE_DIR + "/") and not v.store_attached:
            store_skipped += 1
            continue
        in_place = filed.startswith((ATTACH_DIR + "/", STORE_DIR + "/")) and not filed.startswith(RAW_DIR + "/")
        if not in_place or not f.is_file():
            yield Finding("manifest", ERROR, MANIFEST, n,
                          f"filed file missing: {filed} (it is the only copy: restore it from git or, for _files/, from the store backup; or update the row if it was renamed)")
            continue
        if f.stat().st_size != int(size):
            yield Finding("manifest", ERROR, MANIFEST, n, f"filed file changed since import (size): {filed}")
            continue
        if HASH_MANIFEST:
            h = hashlib.sha256()
            with f.open("rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    h.update(chunk)
            if h.hexdigest() != sha:
                yield Finding("manifest", ERROR, MANIFEST, n, f"filed file changed since import (checksum): {filed}")
    if store_skipped:
        yield Finding("manifest", INFO, MANIFEST, 0,
                      f"{store_skipped} row(s) name file store files; the store isn't attached here, so they weren't checked")


@check("anatomy", "required body sections and Dataview blocks per note type (Agents/body-sections.md)")
def check_anatomy(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.is_note or not n.fm or n.is_template:
            continue
        secs = sections(n)
        for name in REQUIRED_SECTIONS.get(n.folder, []):
            if name not in secs:
                yield Finding("anatomy", WARNING, n.rel, n.body_start_line,
                              f"missing required '## {name}' section (Dataview block, see Agents/body-sections.md)")
            elif not (any(re.match(r"^ {0,3}(```|~~~)\s*dataview\b", l) for l in secs[name][1])
                      or any(ok for _, _, ok in dvjs_blocks(secs[name][1]))):
                yield Finding("anatomy", WARNING, n.rel, secs[name][0],
                              f"'## {name}' has no Dataview block")
        h1s = [ln for ln, s in body_lines_outside_code(n) if s.startswith("# ")]
        for ln in h1s[1:]:
            yield Finding("anatomy", WARNING, n.rel, ln, "second '# ' heading; the title is the only H1, use '##'")
        if n.folder == "Agents" and n.stem != "README":
            first = next((s for _, s in body_lines_outside_code(n)
                          if s.strip() and not s.startswith("# ")), "")
            if "[[README]]" not in first:
                yield Finding("anatomy", WARNING, n.rel, n.body_start_line,
                              "first line after the H1 should be 'Part of the [[README]].'")
        if n.folder == "Resources":
            rtype = n.fm.scalar("type")
            if rtype == "log" and not n.fm.get("date"):
                yield Finding("anatomy", WARNING, n.rel, n.fm.get("type").line, "log resource has no 'date'")
        if "Someday/maybe" in secs:
            ln0 = secs["Someday/maybe"][0]
            if n.folder not in ("Areas", "Agents"):
                yield Finding("anatomy", WARNING, n.rel, ln0, "'## Someday/maybe' belongs in Area notes")
            for i, line in enumerate(secs["Someday/maybe"][1]):
                for m in REVISIT.finditer(line):
                    if not parse_date(m.group(1).strip()):
                        yield Finding("anatomy", WARNING, n.rel, ln0 + 1 + i,
                                      f"'(revisit {m.group(1)})' needs an ISO date: (revisit YYYY-MM-DD)")
        tag = next((i + 1 for i, line in enumerate(n.text.split("\n")) if TEMPLATER_TAG.search(line)), None)
        if tag:
            yield Finding("anatomy", WARNING, n.rel, tag,
                          "Templater tag outside Agents/templates/; replace it with its value")
        for ln, line in body_lines_outside_code(n):
            # Emoji are fine in body text; only section headings stay plain (heading links match them exactly).
            if HEADING_EMOJI_LINE.match(line) and _BODY_EMOJI.search(line):
                yield Finding("anatomy", WARNING, n.rel, ln, "emoji in heading")
                break


