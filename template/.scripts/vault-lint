MAX_NOTE_BYTES = 2_000_000  # bigger notes are indexed but not content-checked


@dataclass
class Note:
    rel: str                  # "Tasks/foo.md"
    folder: str               # top-level content folder (Tasks | …) | Home | Root | Stray
    stem: str
    text: str                 # decoded, BOM stripped, CRLF normalised to LF
    fm: Optional[Frontmatter]
    fm_error: Optional[str]
    raw: str = ""             # decoded text exactly as on disk (minus BOM)
    bom: bool = False
    crlf: bool = False
    bad_utf8: bool = False
    too_large: bool = False

    @property
    def fixable_file(self) -> bool:
        """Whether --fix may rewrite this file at all."""
        return not (self.bad_utf8 or self.too_large)

    @property
    def body_start_line(self) -> int:
        return self.fm.end_line + 1 if self.fm else 1

    @property
    def body(self) -> str:
        return self.text[self.fm.body_offset:] if self.fm else self.text

    @property
    def title(self) -> Optional[str]:
        return self.fm.scalar("title") if self.fm else None

    @property
    def state_entry(self) -> Optional["Entry"]:
        """The GTD state field: a project's `phase`, a task's `status` (Agents/schema.md)."""
        if not self.fm:
            return None
        if self.folder == "Projects":
            return self.fm.get("phase")
        if self.folder == "Tasks":
            return self.fm.get("status")
        return self.fm.get("phase") or self.fm.get("status")

    @property
    def state(self) -> Optional[str]:
        e = self.state_entry
        return e.value.text if e and e.kind == "scalar" and e.value else None

    @property
    def is_project(self) -> bool:
        """In Projects/, or archived from there."""
        return self.folder == "Projects" or (self.folder == "Archive" and self.fm is not None
                                             and self.fm.scalar("archived_from") == "Projects")

    @property
    def is_note(self) -> bool:
        return self.folder in CONTENT_DIRS or self.folder == "Home"

    @property
    def is_template(self) -> bool:
        """Manual templates: body is Templater source, exempt from body checks."""
        return self.rel.startswith(TEMPLATE_DIR + "/") or (
            self.folder == "Agents" and self.fm is not None and self.fm.scalar("type") == "template")


def body_lines_outside_code(note: Note) -> Iterator[tuple]:
    """Yield (line_no, text) for body lines, with fenced blocks skipped and
    inline code spans blanked out."""
    fence = None
    for i, line in enumerate(note.body.split("\n")):
        ln = note.body_start_line + i
        m = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence) \
                    and line.strip() == m.group(1):
                fence = None
            continue
        if m:
            fence = m.group(1)
            continue
        yield ln, re.sub(r"(`+)(.+?)\1", lambda mm: " " * len(mm.group(0)), line)


def parse_link(inner: str) -> str:
    """'target#h|alias' -> 'target#h' (handles table-escaped '\\|')."""
    target = re.split(r"\\?\|", inner, maxsplit=1)[0]
    return target.strip()


class Vault:
    def __init__(self, root: Path, today: dt.date):
        self.root = root
        self.today = today
        self.notes: dict = {}          # rel -> Note
        self.files: list = []          # every non-dot file rel path
        self.dirs: list = []           # every non-dot dir rel path
        self.by_stem: dict = {}        # lower stem -> [rel] (md notes)
        self.by_name: dict = {}        # lower filename -> [rel] (any file)
        self.by_path: dict = {}        # lower rel path (and without .md) -> rel
        self.symlinks: list = []       # rel paths that are symlinks (never followed)
        self.store_files: list = []    # rel paths under _files/, when the store is attached
        self.cfg = load_config(root)
        for key in self.cfg["retired_fields"]:  # this vault's own retired fields: an error, and --fix deletes them
            if key not in RETIRED:
                RETIRED.append(key)
            RETIRED_REDUNDANT.add(key)
        self.store_state = store_state(root, self.cfg["store_image"])
        self.store_attached = self.store_state == "attached"
        self._scan()
        if self.store_attached:
            self._scan_store()

    def _scan(self):
        for dirpath, dirnames, filenames in os.walk(self.root):
            reldir = os.path.relpath(dirpath, self.root)
            reldir = "" if reldir == "." else reldir
            keep = []
            for d in sorted(dirnames):
                if d.startswith(".") or (reldir == "" and d in SKIPPED_DIRS):
                    continue  # tooling, agent scratch, and the drop folders: never indexed
                rel = f"{reldir}/{d}" if reldir else d
                if os.path.islink(os.path.join(dirpath, d)):
                    self.symlinks.append(rel)  # os.walk won't descend; report only
                    continue
                keep.append(d)
                self.dirs.append(rel)
            dirnames[:] = keep
            for fn in sorted(filenames):
                if fn.startswith(".") or fn in IGNORED_NAMES or (reldir == "" and fn in SKIPPED_DIRS):
                    continue  # (a store symlink whose target is missing lists as a file)
                rel = f"{reldir}/{fn}" if reldir else fn
                if os.path.islink(os.path.join(dirpath, fn)):
                    self.symlinks.append(rel)  # resolvable as a link target, never read
                    self.by_name.setdefault(fn.lower(), []).append(rel)
                    self.by_path[rel.lower()] = rel
                    if fn.endswith(".md"):
                        self.by_path[rel[:-3].lower()] = rel
                        self.by_stem.setdefault(fn[:-3].lower(), []).append(rel)
                    continue
                self.files.append(rel)
                self.by_name.setdefault(fn.lower(), []).append(rel)
                self.by_path[rel.lower()] = rel
                if fn.endswith(".md"):
                    self.by_path[rel[:-3].lower()] = rel
                    self.by_stem.setdefault(fn[:-3].lower(), []).append(rel)
                    if not rel.startswith(ATTACH_DIR + "/") and ("/" in rel or rel == "Home.md"):
                        self._load(rel)  # root AGENTS.md is not a vault note

    def _scan_store(self):
        """Index the file store through the _files symlink (followed, unlike other symlinks)."""
        base = self.root / STORE_DIR
        for dirpath, dirnames, filenames in os.walk(base, followlinks=True):
            top = os.path.realpath(dirpath) == os.path.realpath(base)
            # _private/ holds values waiting for the password manager (Agents/sensitive-data.md): never indexed or linked
            dirnames[:] = sorted(d for d in dirnames if not d.startswith(".") and not (top and d == STORE_PRIVATE))
            reldir = os.path.relpath(dirpath, base)
            for fn in sorted(filenames):
                if fn.startswith(".") or fn in IGNORED_NAMES:
                    continue
                rel = STORE_DIR + "/" + (f"{reldir}/{fn}" if reldir != "." else fn)
                self.store_files.append(rel)
                self.by_name.setdefault(fn.lower(), []).append(rel)
                self.by_path[rel.lower()] = rel

    def _load(self, rel: str):
        parts = rel.split("/")
        if len(parts) == 1:
            folder = "Home" if rel == "Home.md" else "Root"
        elif parts[0] in CONTENT_DIRS:
            folder = parts[0]  # subfolders keep their top-level folder's schema
        else:
            folder = "Stray"
        path = self.root / rel
        flags = {}
        try:
            size = path.stat().st_size
            data = b"" if size > MAX_NOTE_BYTES else path.read_bytes()
        except OSError:
            size, data = 0, b""
            flags["bad_utf8"] = True  # unreadable: reported by file-format
        if size > MAX_NOTE_BYTES:
            flags["too_large"] = True
        try:
            raw = data.decode("utf-8")
        except UnicodeDecodeError:
            raw = data.decode("utf-8", errors="replace")
            flags["bad_utf8"] = True
        if raw.startswith("﻿"):
            raw = raw[1:]
            flags["bom"] = True
        text = raw
        if "\r\n" in raw:
            flags["crlf"] = True
            text = raw.replace("\r\n", "\n")
        fm, err = (None, None)
        if flags.get("too_large"):
            err = "file too large to check"
        elif folder != "Root" or text.startswith("---\n"):
            fm, err = parse_frontmatter(text)
        self.notes[rel] = Note(rel, folder, Path(rel).stem, text, fm, err, raw=raw, **flags)

    # -- link resolution ---------------------------------------------------
    def resolve_all(self, target: str, source: str) -> list:
        """Every file a link target could mean (Obsidian matches basenames
        case-insensitively, so duplicates make a link ambiguous)."""
        target = target.split("#", 1)[0].strip()
        if target == "":
            return [source]  # same-note heading/block link
        low = target.lower().lstrip("/")
        if "/" in low:
            hit = self.by_path.get(low) or self.by_path.get(low + ".md")
            if hit:
                return [hit]
            # Obsidian also accepts a path suffix.
            return sorted({r for k, r in self.by_path.items() if k.endswith("/" + low)
                           or k.endswith("/" + low + ".md")})
        if low.endswith(".md"):
            low = low[:-3]
        return list(self.by_stem.get(low) or self.by_name.get(low) or [])

    def resolve(self, target: str, source: str) -> Optional[str]:
        """Best single match: exact-case basename, then same folder as source."""
        cands = self.resolve_all(target, source)
        if len(cands) <= 1:
            return cands[0] if cands else None
        base = target.split("#", 1)[0].strip()
        exact = [c for c in cands if Path(c).stem == base or Path(c).name == base]
        same = [c for c in cands if self.folder_of(c) == self.folder_of(source)]
        return (exact or same or cands)[0]

    def folder_of(self, rel: str) -> str:
        return rel.split("/", 1)[0] if "/" in rel else ""

    def archive_origin(self, rel: str) -> Optional[str]:
        """Folder an Archive note came from: archived_from, else inferred."""
        note = self.notes.get(rel)
        if not note or not note.fm:
            return None
        origin = note.fm.scalar("archived_from")
        if origin:
            return origin
        keys = {e.key for e in note.fm.entries}
        if "relationship" in keys:
            return "People"
        if note.fm.scalar("type") in RESOURCE_TYPES:
            return "Resources"
        status = note.fm.scalar("status")
        if status in ("inbox", "queued", "next-action", "waiting-for") or keys & {"project", "parent", "blocked_by"}:
            return "Tasks"
        if "phase" in keys:
            return "Projects"
        return None

    @property
    def refs(self) -> dict:
        """rel -> {source rel: embedded?}; computed once."""
        if not hasattr(self, "_refs"):
            self._refs = _references(self)
        return self._refs

    def content_notes(self, *folders) -> Iterator[Note]:
        for n in self.notes.values():
            if n.folder in folders:
                yield n


