def parse_config(text: str) -> dict:
    """The restricted YAML of .tidyvault.yml: `key: scalar`, `key:` + `  - item` lists, `key: []`,
    and one nested map level (`lint:` + indented keys). Scalars are plain or double-quoted."""
    def scalar(raw):
        raw = raw.strip()
        if raw == "[]":
            return []
        if len(raw) >= 2 and raw[0] == raw[-1] == '"':
            return raw[1:-1].replace('\\"', '"').replace("\\\\", "\\")
        return raw
    out: dict = {}
    parent = None   # top-level key holding a nested map
    target = None   # (dict, key) the next "- item" appends to
    for n, line in enumerate(text.split("\n"), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        body = line.strip()
        if body.startswith("- "):
            if target is None:
                raise ValueError(f"line {n}: list item without a key")
            d, k = target
            if not isinstance(d.get(k), list):
                d[k] = []
            d[k].append(scalar(body[2:]))
            continue
        key, sep, rest = body.partition(":")
        if not sep or not re.fullmatch(r"[A-Za-z_][\w-]*", key):
            raise ValueError(f"line {n}: expected 'key: value'")
        if indent == 0:
            parent = None
            d = out
        elif parent is not None and indent == 2:
            d = out[parent]
        else:
            raise ValueError(f"line {n}: unexpected indent")
        if rest.strip():
            d[key] = scalar(rest)
            target = None
        else:
            d[key] = None  # a list or (top level only) a nested map, decided by the next line
            target = (d, key)
            if indent == 0:
                parent = key
                out[key] = {}
                target = (out, key)
    for k, val in list(out.items()):
        if val == {}:
            out[k] = None
    return out


def load_config(root) -> dict:
    """Read .tidyvault.yml; defaults when it's missing: every module on, owner "the owner"."""
    root = Path(root)
    cfg: dict = {}
    path = root / CONFIG_FILE
    if path.is_file():
        try:
            cfg = parse_config(path.read_text(encoding="utf-8"))
        except (ValueError, UnicodeDecodeError, OSError) as e:
            print(f"vault-lint: {CONFIG_FILE}: {e}; using defaults", file=sys.stderr)
            cfg = {}
    lint = cfg.get("lint") if isinstance(cfg.get("lint"), dict) else {}
    as_list = lambda x: [str(i) for i in x] if isinstance(x, list) else ([] if not x else [str(x)])
    vault = str(cfg.get("vault") or root.name)
    modules = cfg.get("modules")
    store_path = os.path.expanduser(str(cfg.get("store_path") or f"~/{vault}-files"))
    return {
        "owner": str(cfg.get("owner") or "the owner"),
        "owner_full": str(cfg.get("owner_full") or cfg.get("owner") or ""),  # "" without a config
        "owner_slug": str(cfg.get("owner_slug") or ""),
        "vault": vault,
        "modules": set(as_list(modules)) if modules is not None or "modules" in cfg else set(MODULES),
        "store_path": store_path,
        "store_image": os.path.expanduser(os.environ.get("VAULT_FILES_IMAGE")
                                          or str(cfg.get("store_image") or store_path + ".sparsebundle")),
        "proper_nouns": as_list(lint.get("proper_nouns")),
        "proper_phrases": as_list(lint.get("proper_phrases")),
        "disabled_checks": set(as_list(lint.get("disabled_checks"))),
        "read_only_url_patterns": as_list(lint.get("read_only_url_patterns")),
        "retired_fields": as_list(lint.get("retired_fields")),
    }


def check_off(cid: str, cfg: dict) -> Optional[str]:
    """Why a check is off in this vault, or None when it runs."""
    mod = CHECK_MODULES.get(cid)
    if mod and mod not in cfg["modules"]:
        return f"module {mod} is off"
    if cid in cfg["disabled_checks"]:
        return "lint.disabled_checks"
    return None


def store_state(root, image: str) -> str:
    """'attached', 'locked', or 'absent'. The store is an encrypted disk image mounted at the
    symlink's target (.scripts/store-image). Where the image exists, only a mounted target counts
    (a different device from its parent); the bare mount point is locked, and anything in it sits
    outside the encryption. Without an image, a plain folder is the store, as before."""
    link = Path(root) / STORE_DIR
    if not (link.is_symlink() and link.is_dir()):  # Sync can leave an empty real folder
        return "absent"
    if not os.path.exists(image):
        return "attached"
    target = link.resolve()
    return "attached" if target.stat().st_dev != target.parent.stat().st_dev else "locked"


def belongs_in_store(rel: str, size: int) -> bool:
    """A filed attachment that lives in the file store: every file but a note, whatever its size."""
    return not rel.lower().endswith(".md")
