# this list in lint.proper_phrases of .tidyvault.yml.
PROPER_PHRASES = ["Claude Code", "Obsidian Sync", "Visual Studio Code"]


def _proper_nouns(v: Vault) -> set:
    names = set(PROPER_NOUNS) | set(v.cfg["proper_nouns"])
    for w in re.findall(r"[A-Za-z][\w'’-]*", v.cfg["owner_full"]):
        names.add(w)
        names.add(w + "'s")
        names.add(w + "’s")
    for n in v.content_notes("People", "Areas"):
        for w in re.findall(r"[A-Za-z][\w'’-]*", n.title or ""):
            names.add(w)
            names.add(w + "'s")
            names.add(w + "’s")
    return names


def title_case_ratio(title: str, proper: set, phrases: Iterable[str] = ()) -> tuple:
    for phrase in list(PROPER_PHRASES) + list(phrases):
        title = re.sub(re.escape(phrase), "0", title, flags=re.I)
    words = [w.strip("()[]{}\"“”,.:;!?—–") for w in title.split()]
    words = [w for w in words if w]
    rest = words[1:]
    if len(rest) < 3:
        return 0, len(rest)
    caps = 0
    for w in rest:
        if w in proper or any(c.isdigit() for c in w):
            continue
        letters = re.sub(r"[^A-Za-z]", "", w)
        if len(letters) >= 2 and letters.isupper():
            continue  # acronym
        if w[0].isupper():
            caps += 1
    return caps, len(rest)


@check("title", "title present, sentence case, matches the H1, no emoji")
def check_title(v: Vault) -> Iterator[Finding]:
    proper = _proper_nouns(v)
    for n in v.notes.values():
        if not n.is_note or not n.fm:
            continue
        e = n.fm.get("title")
        t = n.title
        if not t:
            continue  # schema reports missing title
        line = e.line
        if has_emoji(t):
            yield Finding("title", ERROR, n.rel, line, "emoji in title")
        if re.search("[\u2018\u2019\u201c\u201d]", t):
            yield Finding("title", WARNING, n.rel, line, "curly quotes in title; use straight ' and \" (the H1 must match)")
        caps, total = title_case_ratio(t, proper, v.cfg["proper_phrases"])
        if total and caps / total > 0.5:
            yield Finding("title", WARNING, n.rel, line, f"title looks like Title Case; use sentence case: {t}")
        if re.search(r"[.,;:!?]$", t):
            yield Finding("title", WARNING, n.rel, line, "title ends with punctuation")
        if n.folder == "Archive" and re.match(r"^[(\[]?archived\b", t, re.I):
            yield Finding("title", WARNING, n.rel, line, "Archive titles take no '(Archived)' prefix")
        if n.is_template:
            continue
        h1 = next(((ln, s[2:].strip()) for ln, s in body_lines_outside_code(n) if s.startswith("# ")), None)
        if h1 is None:
            yield Finding("title", ERROR, n.rel, n.body_start_line, f"no '# {t}' H1 in body")
        elif h1[1] != t:
            yield Finding("title", ERROR, n.rel, h1[0], f"H1 '{h1[1]}' does not match title '{t}'")


def _check_type(spec, entry: Entry, folder: str) -> Iterator[str]:
    kind, arg = spec
    is_list = entry.kind in ("list", "inline")
    if entry.kind == "empty":
        return
    if kind in ("links", "tags", "enum-list", "text-list"):
        if not is_list:
            yield f"'{entry.key}' must be a block list"
            return
        for it in entry.items:
            if kind == "tags" and not KEBAB.match(it.text):
                yield f"tag '{it.text}' must be kebab-case with no '#'"
            if kind == "text-list" and WIKILINK_ANY.search(it.text):
                yield f"'{entry.key}' holds plain text, not links: {it.text}"
            if kind == "enum-list" and it.text not in arg:
                yield f"'{entry.key}' value '{it.text}' not in {{{', '.join(sorted(arg))}}}"
        return
    if is_list:
        yield f"'{entry.key}' must be a single value, not a list"
        return
    val = entry.value.text
    if kind == "enum" and val not in arg:
        yield f"'{entry.key}: {val}' not in {{{', '.join(sorted(arg))}}}"
    elif kind == "date" and not parse_date(val):
        yield f"'{entry.key}: {val}' is not an ISO date (YYYY-MM-DD)"
    elif kind == "true" and val != "true":
        yield f"'{entry.key}' is only present when true; delete it otherwise"
    elif kind == "url" and not val.startswith("http"):
        yield f"'url: {val}' must start with http"
    elif kind == "text" and val.strip() == "":
        yield f"'{entry.key}' is empty"


@check("schema", "per-folder fields, required fields, enums, types, retired fields")
def check_schema(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.is_note or not n.fm:
            continue
        spec = dict(schema_for(n))
        for e in n.fm.entries:
            if e.key in RETIRED:
                redundant = e.key in RETIRED_REDUNDANT or (e.key == "archive" and e.value and e.value.text == "false")
                yield Finding("schema", ERROR, n.rel, e.line, f"retired field '{e.key}'",
                              redundant and not n.fm.unsafe)
                continue
            if e.key == "status" and _status_to_phase(n):
                yield Finding("schema", ERROR, n.rel, e.line,
                              "projects take 'phase', not 'status' (Agents/schema.md)", not n.fm.unsafe)
                continue
            if e.key not in spec:
                where = "Home.md" if n.folder == "Home" else f"{n.folder}/"
                yield Finding("schema", ERROR, n.rel, e.line, f"field '{e.key}' is not allowed in {where}")
                continue
            for msg in _check_type(spec[e.key], e, n.folder):
                yield Finding("schema", ERROR, n.rel, e.line, msg)
        is_log = n.folder == "Agents" and n.fm.scalar("type") == "log"
        for req in REQUIRED.get(n.folder, []) + (["date"] if is_log else []):
            e = n.fm.get(req)
            if e is None or e.kind == "empty":
                yield Finding("schema", ERROR, n.rel, 1, f"required field '{req}' missing")
        for val in n.fm.values("tags"):
            if val.text in NOT_TOPIC_TAGS:
                yield Finding("schema", WARNING, n.rel, val.line,
                              f"tag '{val.text}' is a status/type/context/priority; tags are topics only")
        if n.folder == "Agents" and (n.fm.scalar("type") == "log") != n.rel.startswith(LOG_DIR + "/"):
            yield Finding("schema", ERROR, n.rel, n.fm.get("type").line if n.fm.get("type") else 1,
                          f"{LOG_DIR}/ notes, and only they, take 'type: log'")
        if n.folder == "Agents" and n.fm.scalar("type") in ("manual", "template"):
            named = n.rel.startswith(TEMPLATE_DIR + "/")
            if named != (n.fm.scalar("type") == "template"):
                yield Finding("schema", ERROR, n.rel, n.fm.get("type").line,
                              f"{TEMPLATE_DIR}/ notes, and only they, take 'type: template'")
        if n.folder == "Resources" and n.fm.get("date") and n.fm.scalar("type") not in (None, "document", "log"):
            yield Finding("schema", WARNING, n.rel, n.fm.get("date").line,
                          "'date' is for document and log resources")
        if n.folder == "Resources" and n.fm.scalar("type") == "log" and \
                any(v.text == "agent-work" for v in n.fm.values("tags")):
            yield Finding("schema", WARNING, n.rel, n.fm.get("type").line,
                          f"an agent's run record goes in {LOG_DIR}/, not a log Resource")


NOT_TOPIC_TAGS = (set(TASK_STATUS) | set(PROJECT_PHASE) | CONTEXTS | RESOURCE_TYPES | PRIORITY
                  | {"task", "project", "area", "person", "resource", "todo", "someday"})
LINK_FIELD_KINDS = {"link", "links"}


@check("links", "every wikilink/embed resolves; frontmatter link fields hold only links")
def check_links(v: Vault) -> Iterator[Finding]:
    unchecked: dict = {}  # note -> store links that couldn't be checked (store not attached)
    for n in v.notes.values():
        if n.fm:
            spec = dict(schema_for(n)) if n.is_note else {}
            for e in n.fm.entries:
                is_link_field = spec.get(e.key, (None,))[0] in LINK_FIELD_KINDS
                for val in n.fm.values(e.key):
                    if is_link_field and not WIKILINK_FULL.match(val.text.strip()):
                        yield Finding("links", ERROR, n.rel, val.line,
                                      f"'{e.key}' must hold only [[links]], found: {val.text[:60]}")
                    for m in WIKILINK_ANY.finditer(val.text):
                        tgt = parse_link(m.group(2))
                        if v.resolve(tgt, n.rel) is None:
                            yield Finding("links", ERROR, n.rel, val.line, f"unresolved link [[{tgt}]]")
                        elif n.is_note and re.search(r"[|/#]|\.md$", m.group(2)):
                            yield Finding("links", WARNING, n.rel, val.line,
                                          f"frontmatter links are bare slugs: [[{Path(tgt.split('#')[0]).stem}]], "
                                          "no folder, .md, heading or display text")
        if n.is_template:
            continue
        for ln, line in body_lines_outside_code(n):
            for m in WIKILINK_ANY.finditer(line):
                tgt = parse_link(m.group(2))
                hit = v.resolve(tgt, n.rel)
                kind = "embed" if m.group(1) else "link"
                if hit is None and tgt.startswith(STORE_DIR + "/"):
                    # File store links resolve through the _files symlink, which only the Mac has.
                    store_file = v.root / tgt.split("#", 1)[0].split("|", 1)[0].strip()
                    if not v.store_attached:
                        unchecked[n.rel] = unchecked.get(n.rel, 0) + 1
                    elif not store_file.is_file():
                        yield Finding("links", ERROR, n.rel, ln, f"{kind} not found in the file store [[{tgt}]]")
                    continue
                if hit is None:
                    yield Finding("links", ERROR, n.rel, ln, f"unresolved {kind} [[{tgt}]]")
                elif "#" in tgt and not _anchor_ok(v, hit, tgt.split("#", 1)[1]):
                    yield Finding("links", WARNING, n.rel, ln,
                                  f"[[{tgt}]]: no such heading or block in {hit}")
                elif m.group(1) and hit.endswith(".md"):
                    yield Finding("links", WARNING, n.rel, ln,
                                  f"![[{tgt}]] transcludes a note; embeds are for attachments, use [[{tgt}]]")
    if unchecked:  # one line per run, not one per link (Agents/organization.md, File store)
        why = "locked (.scripts/store-image unlock)" if v.store_state == "locked" else "not attached here"
        yield Finding("links", INFO, STORE_DIR + "/", 0,
                      f"file store {why}; {sum(unchecked.values())} link(s) in {len(unchecked)} note(s) not checked")


def _norm_heading(h: str) -> str:
    return re.sub(r"[^\w]+", " ", h.lower()).strip()


def _anchor_ok(v: Vault, rel: str, anchor: str) -> bool:
    """Does `rel` have the heading (last '#' segment) or ^block the link names?"""
    note = v.notes.get(rel)
    if note is None or note.too_large or not anchor.strip():
        return True  # attachments, unloaded notes: nothing to check
    anchor = anchor.split("#")[-1].strip()
    if anchor.startswith("^"):
        return re.search(r"(?m)\s" + re.escape(anchor) + r"\s*$", note.body) is not None
    want = _norm_heading(anchor)
    if want == _norm_heading(note.title or ""):
        return True
    return any(_norm_heading(line.lstrip("#")) == want
               for _, line in body_lines_outside_code(note) if re.match(r"^#{1,6} ", line))


def _relation_ok(v: Vault, rel: str, folders: set) -> bool:
    folder = v.folder_of(rel)
    if folder in folders:
        return True
    if "roles" in folders and rel.startswith(ROLE_DIR + "/role-"):
        return True  # a task an agent owns (Agents/gtd.md, Agent tasks)
    if folder == "Archive":
        origin = v.archive_origin(rel)
        return origin is None or origin in folders
    return False


@check("relations", "relation fields point into the right folder")
def check_relations(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.is_note or not n.fm or n.folder in ("Agents", "Home"):
            continue
        for key, folders in RELATION_TARGETS.items():
            for val in n.fm.values(key):
                tgt = link_target(val)
                if not tgt:
                    continue
                cands = v.resolve_all(tgt, n.rel)
                if not cands or any(_relation_ok(v, c, folders) for c in cands):
                    continue  # unresolved is reported by `links`; ambiguity by `filename`
                rel = cands[0]
                folder = v.folder_of(rel)
                want = " or ".join(sorted(folders))
                yield Finding("relations", ERROR, n.rel, val.line,
                              f"'{key}' → [[{tgt}]] is in {folder or 'the vault root'}/, expected {want}/")


@check("waiting-on", "waiting_on points to a person or an organization Resource")
def check_waiting_on(v: Vault) -> Iterator[Finding]:
    for n in v.notes.values():
        if not n.is_note or not n.fm:
            continue
        for val in n.fm.values("waiting_on"):
            tgt = link_target(val)
            rel = v.resolve(tgt, n.rel) if tgt else None
            if rel and v.folder_of(rel) == "Resources":
                t = v.notes.get(rel)
                if not (t and t.fm and t.fm.scalar("type") == "organization"):
                    yield Finding("waiting-on", ERROR, n.rel, val.line,
                                  f"'waiting_on' → [[{tgt}]] is a Resource but not type: organization")


def _tasks_for_projects(v: Vault) -> dict:
    out: dict = {}
    for t in v.content_notes("Tasks"):
        if not t.fm:
            continue
        for val in t.fm.values("project"):
            tgt = link_target(val)
            rel = v.resolve(tgt, t.rel) if tgt else None
            if rel:
                out.setdefault(rel, []).append(t)
    return out


def _word_count(title: str) -> int:
    return len([w for w in re.split(r"\s+", title.strip()) if re.search(r"\w", w)])


@check("tasks", "GTD task rules: name length, waiting-for, project/area, blockers, due, closure")
def check_tasks(v: Vault) -> Iterator[Finding]:
    for t in v.content_notes("Tasks"):
        fm = t.fm
        if not fm:
            continue
        status = fm.scalar("status")
        title = t.title or ""
        tl = fm.get("title").line if fm.get("title") else 1
        sl = fm.get("status").line if fm.get("status") else 1
        wc = _word_count(title)
        if title and not (2 <= wc <= 5):
            yield Finding("tasks", WARNING, t.rel, tl, f"task name is {wc} words; keep it 2–5")
        is_open = status in OPEN_TASK
        if status == "waiting-for":
            for req in ("waiting_on", "waiting_since"):
                if not fm.get(req):
                    yield Finding("tasks", ERROR, t.rel, sl, f"waiting-for task needs '{req}'")
        if is_open and not fm.values("project") and not fm.values("area"):
            yield Finding("tasks", ERROR, t.rel, sl, "open task has neither 'project' nor 'area'")
        if fm.values("project") and fm.values("area"):
            yield Finding("tasks", WARNING, t.rel, fm.get("area").line,
                          "'area' is only for tasks without a 'project'")
        if status == "inbox" and fm.values("project"):
            yield Finding("tasks", WARNING, t.rel, sl,
                          "inbox task already has a 'project'; it's clarified, so make it queued or next-action")
        if status == "queued" and not fm.values("project") and not fm.values("blocked_by"):
            yield Finding("tasks", WARNING, t.rel, sl,
                          "queued is for project steps or blocked tasks; set 'project' or 'blocked_by', or make it next-action")
        if status == "inbox" and fm.get("due"):
            yield Finding("tasks", WARNING, t.rel, fm.get("due").line,
                          "inbox task has a 'due' date; clarify it now")
        if status == "next-action":
            for val in fm.values("blocked_by"):
                tgt = link_target(val)
                rel = v.resolve(tgt, t.rel) if tgt else None
                blocker = v.notes.get(rel) if rel else None
                if blocker and blocker.fm and blocker.fm.scalar("status") in OPEN_TASK:
                    yield Finding("tasks", WARNING, t.rel, val.line,
                                  f"next-action is blocked by open task [[{tgt}]]; a blocked task isn't next-action")
        due = parse_date(fm.scalar("due") or "")
        if is_open and due and due < v.today:
            yield Finding("tasks", WARNING, t.rel, fm.get("due").line,
                          f"overdue: due {due.isoformat()} and still {status}")
        if status in CLOSED:
            yield Finding("tasks", WARNING, t.rel, sl, f"task is {status}; archive it")
            if not fm.get("completed"):
                yield Finding("tasks", WARNING, t.rel, sl, f"{status} task has no 'completed' date")
        if is_open and fm.get("completed"):
            yield Finding("tasks", ERROR, t.rel, fm.get("completed").line, "open task has a 'completed' date")
        if status in ("inbox", "queued", "next-action"):
            for key in ("waiting_on", "waiting_since"):
                if fm.get(key):
                    yield Finding("tasks", WARNING, t.rel, fm.get(key).line,
                                  f"'{key}' on a {status} task; delete it when the task leaves waiting-for")
        if "agenda" in fm.texts("contexts") and not fm.values("people"):
            yield Finding("tasks", WARNING, t.rel, fm.get("contexts").line,
                          "'agenda' context needs 'people' (who to raise it with)")
        for val in fm.values("assignee"):
            rel = v.resolve(link_target(val) or "", t.rel)
            owner = v.notes.get(rel) if rel else None
            if owner and owner.fm and owner.fm.scalar("relationship") == "self":
                yield Finding("tasks", WARNING, t.rel, val.line,
                              f"'assignee' is for people other than {v.cfg['owner']}; omit it when {v.cfg['owner']} owns the task")
        if is_open:
            for val in fm.values("project"):
                rel = v.resolve(link_target(val) or "", t.rel)
                proj = v.notes.get(rel) if rel else None
                if proj and proj.fm and (proj.folder == "Archive" or proj.state in CLOSED):
                    where = "archived" if proj.folder == "Archive" else proj.state
                    yield Finding("tasks", ERROR, t.rel, val.line,
                                  f"open task under {where} project [[{proj.stem}]]; close the task or reopen the project")
        for val in fm.values("blocked_by"):
            if v.resolve(link_target(val) or "", t.rel) == t.rel:
                yield Finding("tasks", ERROR, t.rel, val.line, "task is blocked by itself")
    yield from _blocker_cycles(v)


def _blocker_cycles(v: Vault) -> Iterator[Finding]:
    """Report each blocked_by cycle once, on its alphabetically first member."""
    graph = {}
    for t in v.content_notes("Tasks"):
        if t.fm:
            deps = [v.resolve(link_target(x) or "", t.rel) for x in t.fm.values("blocked_by")]
            graph[t.rel] = [d for d in deps if d and d != t.rel and d.startswith("Tasks/")]
    seen_cycles = set()
    for start in sorted(graph):
        stack, path = [(start, iter(graph[start]))], [start]
        on_path = {start}
        while stack:
            node, it = stack[-1]
            nxt = next(it, None)
            if nxt is None:
                stack.pop()
                on_path.discard(path.pop())
                continue
            if nxt == start:
                cyc = frozenset(path)
                if cyc not in seen_cycles and min(cyc) == start:
                    seen_cycles.add(cyc)
                    names = " → ".join(Path(p).stem for p in path + [start])
                    yield Finding("tasks", ERROR, start, 0, f"blocked_by cycle: {names}")
                continue
            if nxt in on_path or nxt not in graph or len(path) > 50:
                continue
            path.append(nxt)
            on_path.add(nxt)
            stack.append((nxt, iter(graph[nxt])))


# Agents/gtd.md project state machine: allowed next-action counts per phase (None = no upper limit).
PROJECT_NEXT_ACTIONS = {"planned": (0, 0), "not-started": (1, None), "in-progress": (1, None), "waiting": (0, 0)}


@check("projects", "project state machine (Agents/gtd.md): next actions, waiting, closure")
def check_projects(v: Vault) -> Iterator[Finding]:
    by_project = _tasks_for_projects(v)
    for p in v.content_notes("Projects"):
        if not p.fm:
            continue
        status = p.state
        sl = p.state_entry.line if p.state_entry else 1
        tasks = by_project.get(p.rel, [])
        nexts = [t for t in tasks if t.fm.scalar("status") == "next-action"]
        waits = [t for t in tasks if t.fm.scalar("status") == "waiting-for"]
        open_ = [t for t in tasks if t.fm.scalar("status") in OPEN_TASK]
        names = ", ".join(t.stem for t in nexts[:6]) + (", …" if len(nexts) > 6 else "")
        wc = _word_count(p.title or "")
        if p.title and not 2 <= wc <= 6:
            yield Finding("projects", WARNING, p.rel, p.fm.get("title").line,
                          f"project title is {wc} words; name the outcome in 2–6")
        if status in PROJECT_NEXT_ACTIONS:
            lo, hi = PROJECT_NEXT_ACTIONS[status]
            if lo == 1 and not nexts:
                yield Finding("projects", WARNING, p.rel, sl, f"{status} project has no next action")
            elif hi == 0 and nexts:
                yield Finding("projects", WARNING, p.rel, sl,
                              f"{status} project has {len(nexts)} next-action task(s); it should have none ({names})")
        if status == "waiting" and not waits:
            yield Finding("projects", WARNING, p.rel, sl, "waiting project has no waiting-for task")
        if p.fm.get("health") and not p.fm.get("last_sweep"):
            yield Finding("projects", WARNING, p.rel, p.fm.get("health").line,
                          "'health' without 'last_sweep'; a sweep sets both (Agents/body-sections.md, Project status)")
        if p.fm.get("last_sweep") and "Status" not in sections(p):
            yield Finding("projects", WARNING, p.rel, p.fm.get("last_sweep").line,
                          "swept project has no '## Status' section")
        if status in CLOSED:
            if open_:
                yield Finding("projects", ERROR, p.rel, sl, f"project is {status} but has {len(open_)} open task(s)")
            yield Finding("projects", WARNING, p.rel, sl, f"project is {status}; archive it")
            if not p.fm.get("completed"):
                yield Finding("projects", WARNING, p.rel, sl, f"{status} project has no 'completed' date")


ACTIVE_PROJECT = {"planned", "not-started", "in-progress", "waiting"}


@check("archive", "archived tasks and projects are closed and dated")
def check_archive(v: Vault) -> Iterator[Finding]:
    for n in v.content_notes("Archive"):
        if not n.fm:
            continue
        origin = v.archive_origin(n.rel)
        status = n.state
        sl = n.state_entry.line if n.state_entry else 1
        if origin in ("Tasks", "Projects") and status in (OPEN_TASK | ACTIVE_PROJECT):
            key = "phase" if origin == "Projects" else "status"
            yield Finding("archive", WARNING, n.rel, sl,
                          f"archived but {key} is {status}; close it, or move it back to {origin}/ to reopen")
        if origin in ("Tasks", "Projects") and status in CLOSED and not n.fm.get("completed"):
            yield Finding("archive", INFO, n.rel, sl, f"{status} but no 'completed' date")


